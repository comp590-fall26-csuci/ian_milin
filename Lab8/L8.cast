[23289.752046, "o", "\u001b[1G\u001b[0K\r\nadded 1674 packages, and audited 1675 packages in 4m\r\n⠹"]
[23289.753002, "o", "\u001b[1G\u001b[0K\r\n⠹\u001b[1G\u001b[0K449 packages are looking for funding\r\n⠹\u001b[1G\u001b[0K  run `npm fund` for details\r\n⠹"]
[23290.032874, "o", "\u001b[1G\u001b[0K\r\n\u001b[31m\u001b[1m189\u001b[22m\u001b[39m vulnerabilities (136 \u001b[1mlow\u001b[22m, 45 \u001b[33m\u001b[1mmoderate\u001b[22m\u001b[39m, 3 \u001b[31m\u001b[1mhigh\u001b[22m\u001b[39m, 5 \u001b[35m\u001b[1mcritical\u001b[22m\u001b[39m)\r\n\r\nTo address issues that do not require attention, run:\r\n  npm audit fix\r\n\r\nTo address all issues possible (including breaking changes), run:\r\n  npm audit fix --force\r\n\r\nSome issues need review, and may require choosing\r\na different dependency.\r\n\r\nRun `npm audit` for details.\r\n⠸"]
[23290.033816, "o", "\u001b[1G\u001b[0K\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94minstall-scripts\u001b[39m 1 package has install scripts not yet covered by allowScripts:\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94minstall-scripts\u001b[39m   node-pty@1.2.0-beta.18 (install: node scripts/prebuild.js || node-gyp rebuild; postinstall: node scripts/post-install.js)\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94minstall-scripts\u001b[39m\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94minstall-scripts\u001b[39m Run `npm install-scripts ls` to review, or `npm install-scripts approve <pkg>` to allow.\r\n⠸"]
[23290.038888, "o", "\u001b[1G\u001b[0K\u001b[1mnpm\u001b[22m \u001b[96mnotice\u001b[39m\r\n\u001b[1mnpm\u001b[22m \u001b[96mnotice\u001b[39m New \u001b[31mmajor\u001b[39m version of npm available! \u001b[31m11.19.1\u001b[39m -> \u001b[34m12.2.2\u001b[39m\r\n\u001b[1mnpm\u001b[22m \u001b[96mnotice\u001b[39m Changelog: \u001b[34mhttps://github.com/npm/cli/releases/tag/v12.2.2\u001b[39m\r\n\u001b[1mnpm\u001b[22m \u001b[96mnotice\u001b[39m To update run: \u001b[4mnpm install -g npm@12.2.2\u001b[24m\r\n\u001b[1mnpm\u001b[22m \u001b[96mnotice\u001b[39m\r\n⠸\u001b[1G\u001b[0K"]
