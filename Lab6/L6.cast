[14368.824928, "o", "\u001b[1;1H\u001b[38;5;130m  1 -\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Setup Asciinema and Apache Web Server\r\n\u001b[38;5;130m  2 \u001b[m  \u001b[36mhosts\u001b[m\u001b[35m:\u001b[m targets\u001b[2;21H\u001b[K\u001b[3;1H\u001b[38;5;130m  3 \u001b[m  \u001b[36mbecome\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[3;19H\u001b[K\u001b[4;1H\u001b[38;5;130m  4 \r\n  5 \u001b[m  \u001b[36mpre_tasks\u001b[m\u001b[35m:\u001b[m\r\n\u001b[38;5;130m  6 \u001b[m    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Update apt cache if needed.\r\n\u001b[38;5;130m  7 \u001b[m      \u001b[36mapt\u001b[m\u001b[35m:\u001b[m update_cache=yes cache_valid_time=3600\r\n\u001b[38;5;130m  8 \r\n  9 \u001b[m  \u001b[36mtasks\u001b[m\u001b[35m:\u001b[m\r\n\u001b[38;5;130m 10 \u001b[m    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Install asciinema and apache2 package.\r\n\u001b[38;5;130m 11 \u001b[m      \u001b[36mapt\u001b[m\u001b[35m:\u001b[m\r\n\u001b[38;5;130m 12 \u001b[m\u001b[8C\u001b[36mstate\u001b[m\u001b[35m:\u001b[m present\r\n\u001b[38;5;130m 13 \u001b[m\u001b[8C\u001b[36mname\u001b[m\u001b[35m:\u001b[m\r\n\u001b[38;5;130m 14 \u001b[10C-\u001b[m asciinema\r\n\u001b[38;5;130m 15 \u001b[10C-\u001b[m apache2\r\n\u001b[38;5;130m 16 \r\n 17 \u001b[m    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Start and enable Apache service\r\n\u001b[38;5;130m 18 \u001b[m      \u001b[36mservice\u001b[m\u001b[35m:\u001b[m\r\n\u001b[38;5;130m 19 \u001b[m\u001b[8C\u001b[36mname\u001b[m\u001b[35m:\u001b[m apache2\r\n\u001b[38;5;130m 20 \u001b[m\u001b[8C\u001b[36mstate\u001b[m\u001b[35m:\u001b[m started\r\n\u001b[38;5;130m 21 \u001b[m\u001b[8C\u001b[36menabled\u001b[m\u001b[35m:\u001b[m yes\r\n\u001b[38;5;130m 22 \r\n 23 \u001b[m    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m \u001b[31m\"Complete Task 3\"\u001b[m\r\n\u001b[38;5;130m 24 \u001b[m      \u001b[36mdebug\u001b[