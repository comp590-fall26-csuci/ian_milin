[137620.325773, "o", "\u001b[?2004l\r"]
[137620.333263, "o", "- name: Setup Gitea\r\n  hosts: targets\r\n  become: true\r\n  vars:\r\n    gitea_path: /usr/local/bin/gitea\r\n    gitea_version: 28.3.0\r\n    gitea_checksum: sha256:24d146e8f5c986b86e5a3311e3ec349ded35202cba056952ab5b585511ace82d\r\n    gitea_home: /var/lib/gitea\r\n\r\n    runner_path: /usr/local/bin/gitea-runner\r\n    runner_version: 5.4.1\r\n    runner_checksum: sha256:3ba021458e7a7ea4e8b685451caaea77de0e1aeaca1448d2501c46ec270eae1e"]
[137620.334794, "o", "\r\n    runner_home: /var/lib/gitea-runner\r\n\r\n  pre_tasks:\r\n    - name: Update apt cache if needed.\r\n      apt: update_cache=yes cache_valid_time=3600\r\n\r\n  tasks:\r\n    - name: Install Gitea dependencies.\r\n      apt:\r\n        state: present\r\n        name:\r\n          - git\r\n          - sqlite3\r\n    \r\n    - name: Ensure git user exists.\r\n      user:\r\n        name: git\r\n        system: true\r\n        comment: 'Git Version Control'\r\n        home: '/home/git'\r\n        state: present\r\n\r\n    - name: Ensure required directory structure exists.\r\n      file:\r\n        path: \"{{ item.path }}\"\r\n        state: directory\r\n        owner: \"{{ item.owner }}\"\r\n        group: \"{{ item.group }}\"\r\n        mode: 0750\r\n      loop:\r\n        - { path: '{{ gitea_home }}', owner: 'git', group: 'git' }\r\n        - { path: '{{ gitea_home }}/custom', owner: 'git', group: 'git' }\r\n        - { path: '{{ gitea_home }}/data', owner: 'git', group: 'git' }\r\n        - { path: '{{ gitea_home }}/log', owner: 'git', group: 'git' }\r\n\r\n    - name: Ensure app.ini exists.\r\n      ini_file:\r\n        path: /etc/gitea/app.ini\r\n        section: \"{{ item.section }}\"\r\n        option: \"{{ item.option }}\"\r\n        value: \"{{ item.value }}\"\r\n        owner: git\r\n        group: git\r\n        mode: 0640\r\n      loop:\r\n        - { section: 'database', option: 'DB_TYPE', value: 'sqlite3' }\r\n        - { section: 'database', option: 'PATH', value: '/var/lib/gitea/data/gitea.db' }\r\n        - { section: 'actions', option: 'ENABLED', value: 'true' }\r\n      notify: restart gitea\r\n\r\n    - name: Create service file to start Gitea automatically\r\n      copy:\r\n        dest: /etc/systemd/system/gitea.service\r\n        content: |\r\n          [Unit]\r\n          Description=Gitea (Git with a cup of tea)\r\n          After=syslog.target network.target\r\n          [Service]\r\n          RestartSec=2s\r\n          Type=simple\r\n          User=git\r\n          Group=git\r\n          WorkingDirectory={{ gitea_home }}\r\n          ExecStart={{ gitea_path }} web -c /etc/gitea/app.ini\r\n          Restart=always\r\n          Environment=USER=git HOME=/home/git GITEA_WORK_DIR=/var/lib/gitea\r\n          [Install]\r\n          WantedBy=multi-user.target\r\n        mode: 0644\r\n      notify: reload systemd\r\n\r\n    - name: Download Gitea binary.\r\n      get_url:\r\n        url: \"https://dl.gitea.com/gitea/{{ gitea_version }}/gitea-{{ gitea_version }}-linux-arm64\"\r\n        dest: \"{{ gitea_path }}\"\r\n        mode: 0755\r\n        checksum: \"{{ gitea_checksum }}\"\r\n\r\n    - name: Start and enable Gitea systemd Service.\r\n      systemd_service:\r\n        name: gitea\r\n        state: started\r\n        enabled: true\r\n        daemon_reload: true\r\n\r\n    - name: Wait for Gitea to finish starting.\r\n      wait_for:\r\n        port: 3000\r\n        delay: 5\r\n        timeout: 60\r\n\r\n    - name: Download Gitea Runner binary.\r\n      get_url:\r\n        url: \"https://dl.gitea.com/gitea-runner/{{ runner_version }}/gitea-runner-{{ runner_version }}-linux-arm64\"\r\n        dest: \"{{ runner_path }}\"\r\n        mode: 0755\r\n        checksum: \"{{ runner_checksum }}\"\r\n\r\n    - name: Create gitea runner directory.\r\n      file:\r\n        path: \"{{ runner_home }}\"\r\n        state: directory\r\n        owner: root\r\n        group: root\r\n        mode: 0755\r\n\r\n    - name: Check if Gitea Runner is already registered.\r\n      stat:\r\n        path: \"{{ runner_home }}/.runner\"\r\n      register: runner_reg\r\n\r\n    - name: Generate Gitea Runner token.\r\n      command: >\r\n        sudo -u git GITEA_WORK_DIR={{ gitea_home }} {{ gitea_path }} --config /etc/gitea/app.ini actions generate-runner-token\r\n      register: runner_token_output\r\n      changed_when: false\r\n      when: not runner_reg.stat.exists\r\n\r\n    - name: Register Gitea Runner to run on the host OS\r\n      command: >\r\n        gitea-runner register\r\n        --no-interactive\r\n        --instance http://127.0.0.1:3000\r\n        --token {{ runner_token_output.stdout }}\r\n        --labels \"ubuntu-latest:host,debian-latest:host,local:host\"\r\n      args:\r\n        chdir: \"{{ runner_home }}\"\r\n      when: not runner_reg.stat.exists\r\n\r\n    - name: Create service file "]
[137620.334839, "o", "for Gitea Runner\r\n      copy:\r\n        dest: /etc/systemd/system/gitea-runner.service\r\n        content: |\r\n          [Unit]\r\n          Description=Gitea Actions runner\r\n          After=gitea.service\r\n          [Service]\r\n          ExecStart={{ runner_path }} daemon\r\n          WorkingDirectory={{ runner_home }}\r\n          Environment=\"HOME=/root\"\r\n          Restart=always\r\n          RestartSec=5s\r\n          [Install]\r\n          WantedBy=multi-user.target\r\n        mode: 0644\r\n      notify: reload systemd\r\n\r\n    - name: Start and enable Gitea Runner Service\r\n      systemd:\r\n        name: gitea-runner\r\n        state: started\r\n        enabled: true\r\n        daemon_reload: true\r\n\r\n  handlers:\r\n    - name: restart gitea\r\n      systemd:\r\n        name: gitea\r\n        state: restarted\r\n\r\n    - name: reload systemd\r\n      systemd:\r\n        daemon_reload: true\r\n\u001b[?2004h\u001b]0;parallels@debian-13-6: ~/COMP590Fall2026/LABS/ian_milin/Lab7\u0007\u001b[01;32mparallels@debian-13-6\u001b[00m:\u001b[01;34m~/COMP590Fall2026/LABS/ian_milin/Lab7\u001b[00m$ "]
[137648.680468, "o", "e"]
[137648.981301, "o", "x"]
[137649.375602, "o", "i"]
[137649.463133, "o", "t"]
[137665.095176, "o", "\r\n\u001b[?2004l\rexit\r\n"]
