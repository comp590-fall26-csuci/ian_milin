[127128.504166, "o", "\r\n"]
[127128.507271, "o", "\u001b[?2004l\r"]
[127128.729041, "o", "BECOME password: "]
[127132.364366, "o", "\r\n"]
[127132.506412, "o", "\r\nPLAY [Setup Gitea] *********************************************************************************************************************************************************************\r\n"]
[127132.512816, "o", "\r\nTASK [Gathering Facts] *****************************************************************************************************************************************************************\r\n"]
[127133.205143, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[127133.209872, "o", "\r\nTASK [Update apt cache if needed.] *****************************************************************************************************************************************************\r\n"]
[127136.290435, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[127136.296241, "o", "\r\nTASK [Install Gitea dependencies.] *****************************************************************************************************************************************************\r\n"]
[127137.050742, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[127137.050784, "o", "\r\nTASK [Ensure git user exists.] *********************************************************************************************************************************************************\r\n"]
[127137.319061, "o", "\u001b[0;32mok: [localhost]\u001b[0m"]
[127137.320095, "o", "\r\n"]
[127137.321614, "o", "\r\n"]
[127137.321686, "o", "TASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[127137.554586, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[127137.68673, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[127137.817944, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[127137.950184, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[127137.954228, "o", "\r\nTASK [Ensure app.ini exists.] **********************************************************************************************************************************************************\r\n"]
[127138.178632, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m\r\n"]
[127138.308656, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'PATH', 'value': '/var/lib/gitea/data/gitea.db'})\u001b[0m\r\n"]
[127138.443899, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'actions', 'option': 'ENABLED', 'value': 'true'})\u001b[0m"]
[127138.444112, "o", "\r\n"]
[127138.446532, "o", "\r\nTASK [Create service file to start Gitea automatically] ********************************************************************************************************************************\r\n"]
[127138.802396, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Download Gitea binary.] **********************************************************************************************************************************************************\r\n"]
