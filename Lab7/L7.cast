[124790.113139, "o", "\u001b[1;1H\u001b[93m119\u001b[m\u001b[1C        \u001b[1m\u001b[96mmode\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m0755\u001b[m\u001b[1;23H\u001b[K\u001b[2;1H\u001b[93m120\u001b[m\u001b[2;7H\u001b[K\u001b[3;1H\u001b[93m121\u001b[m\u001b[3C  \u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Force pending handlers to run now\r\n\u001b[93m122\u001b[m\u001b[3C    \u001b[1m\u001b[96mmeta\u001b[m\u001b[38;5;224m:\u001b[m flush_handlers\r\n\u001b[93m123\u001b[m\u001b[5;9H\u001b[K\u001b[6;1H\u001b[93m124\u001b[m\u001b[5C\u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Wait for Gitea to come back online after restart\r\n\u001b[93m125\u001b[m\u001b[5C  \u001b[1m\u001b[96mwait_for\u001b[m\u001b[38;5;224m:\u001b[m\u001b[7;20H\u001b[K\u001b[8;1H\u001b[93m126\u001b[m\u001b[5C    \u001b[1m\u001b[96mport\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m3000\u001b[m\u001b[8;23H\u001b[K\u001b[9;1H\u001b[93m127\u001b[m\u001b[9C\u001b[1m\u001b[96mdelay\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m5\u001b[m\r\n\u001b[93m128\u001b[m\u001b[5C    \u001b[1m\u001b[96mtimeout\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m60\u001b[m\u001b[10;24H\u001b[K\u001b[11;1H\u001b[93m129\u001b[m\u001b[11;9H\u001b[K\u001b[12;1H\u001b[93m130\u001b[m\u001b[5C\u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Check if Gitea Runner is already registered.\u001b[12;61H\u001b[K\u001b[13;1H\u001b[93m131\u001b[m\u001b[5C  \u001b[1m\u001b[96mstat\u001b[m\u001b[38;5;224m:\u001b[m\u001b[13;16H\u001b[K\u001b[14;1H\u001b[93m132\u001b[m\u001b[9C\u001b[1m\u001b[96mpath\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m\"{{ runner_home }}/.runner\"\u001b[m\r\n\u001b[93m133\u001b[m\u001b[3C    \u001b[1m\u001b[96mregister\u001b[m\u001b[38;5;224m:\u001b[m runner_reg\r\n\u001b[93m134\u001b[m\u001b[16;9H\u001b[K\u001b[17;1H\u001b[93m135\u001b[m\u001b[5C\u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Generate Gitea Runner token.\u001b[17;45H\u001b[K\u001b[18;1H\u001b[93m136\u001b[m\u001b[7C\u001b[1m\u001b[96mcommand\u001b[m\u001b[38;5;224m:\u001b[m \u001b[38;5;224m>\u001b[m\r\n\u001b[93m137\u001b[m\u001b[3C      sudo -u git env GITEA_WORK_DIR={{ gitea_home }} {{ gitea_path }} --config /etc/gitea/app.ini actions generate-runner-token\r\n\u001b[93m138\u001b[m\u001b[5C  \u001b[1m\u001b[96mregister\u001b[m\u001b[38;5;224m:\u001b[m runner_token_output\u001b[20;40H\u001b[K\u001b[21;1H\u001b[93m139\u001b[m\u001b[7C\u001b[1m\u001b[96mchanged_when\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95mfalse\u001b[m\r\n\u001b[93m140\u001b[m\u001b[7C\u001b[1m\u001b[96mwhen\u001b[m\u001b[38;5;224m:\u001b[m not runner_reg.stat.exists\r\n\u001b[93m141\u001b[m\u001b[23;13H\u001b[K\u001b[24;1H\u001b[93m142\u001b[m\u001b[5C\u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Register Gitea Runner to run on the host OS\r\n\u001b[93m143\u001b[m\u001b[7C\u001b[1m\u001b[96mcommand\u001b[m\u001b[38;5;224m:\u001b[m \u001b[38;5;224m>\u001b[m\u001b[25;21H\u001b[K\u001b[26;1H\u001b[93m144\u001b[m\u001b[9C\u001b[30m\u001b[103mact_runner\u001b[m register\r\n\u001b[93m145\u001b[m\u001b[5C    --no-interactive\u001b[27;29H\u001b[K\u001b[28;1H\u001b[93m146\u001b[m\u001b[7C  --instance http://127.0.0.1:300\r\n"]
[124790.114637, "o", "\u001b[93m147\u001b[m\u001b[9C--token {{ runner_token_output.stdout }}\r\n\u001b[93m148\u001b[m\u001b[9C--labels \"ubuntu-latest:host,debian-latest:host,local:host\"\r\n\u001b[93m149\u001b[m\u001b[7C\u001b[1m\u001b[96margs\u001b[m\u001b[38;5;224m:\u001b[m\u001b[31;16H\u001b[K\u001b[32;1H\u001b[93m150\u001b[m\u001b[9C\u001b[1m\u001b[96mchdir\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m\"{{ runner_home }}\"\u001b[m\r\n\u001b[93m151\u001b[m\u001b[7C\u001b[1m\u001b[96mwhen\u001b[m\u001b[38;5;224m:\u001b[m not runner_reg.stat.exists\r\n\u001b[93m152\r\n153\u001b[m\u001b[13CSet permissions to read-only after installation.\r\n\u001b[93m154\r\n155\r\n156\u001b[m\u001b[9C\u001b[1m\u001b[96mowner\u001b[m\u001b[38;5;224m:\u001b[m root\u001b[38;24H\u001b[K\u001b[39;1H\u001b[93m157\u001b[m\u001b[9C\u001b[1m\u001b[96mgroup\u001b[m\u001b[38;5;224m:\u001b[m git\u001b[39;23H\u001b[K\u001b[40;1H\u001b[93m158\u001b[m\u001b[9C\u001b[1m\u001b[96mmode\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m\"{{ item.mode }}\"\u001b[m\u001b[40;36H\u001b[K\u001b[41;1H\u001b[93m159\u001b[m\u001b[7C\u001b[1m\u001b[96mloop\u001b[m\u001b[38;5;224m:\u001b[m\u001b[41;16H\u001b[K\u001b[42;1H\u001b[93m160\u001b[m\u001b[7C  \u001b[93m-\u001b[m \u001b[38;5;224m{\u001b[m \u001b[1m\u001b[96mpath\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m'/etc/gitea'\u001b[m, \u001b[1m\u001b[96mmode\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m'0750'\u001b[m \u001b[38;5;224m}\u001b[m\r\n\u001b[93m161\u001b[m\u001b[20C\u001b[95m/etc/gitea/app.ini'\u001b[m, \u001b[1m\u001b[96mmode\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m'0640'\u001b[m \u001b[38;5;224m}\u001b[m\u001b[43;59H\u001b[K\u001b[44;1H\u001b[93m162\u001b[m\u001b[44;13H\u001b[K\u001b[45;1H\u001b[93m163\u001b[m\u001b[3C\u001b[1m\u001b[96mhandlers\u001b[m\u001b[38;5;224m:\u001b[m\u001b[45;17H\u001b[K\u001b[46;1H\u001b[93m164\u001b[m\u001b[5C\u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m restart gitea\u001b[46;30H\u001b[K\u001b[