[113334.43227, "o", "\r\n"]
[113334.571758, "o", "\r\nPLAY [Setup Gitea] *********************************************************************************************************************************************************************\r\n"]
[113334.576627, "o", "\r\nTASK [Gathering Facts] *****************************************************************************************************************************************************************\r\n"]
[113335.35197, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[113335.352756, "o", "\r\nTASK [Update apt cache if needed.] *****************************************************************************************************************************************************\r\n"]
[113336.452788, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[113336.456288, "o", "\r\nTASK [Install Gitea dependencies.] *****************************************************************************************************************************************************\r\n"]
[113337.276634, "o", "\u001b[0;32mok: [localhost]\u001b[0m"]
[113337.279236, "o", "\r\n\r\nTASK [Ensure git user exists.] *********************************************************************************************************************************************************\r\n"]
[113337.566768, "o", "\u001b[0;32mok: [localhost]\u001b[0m"]
[113337.570647, "o", "\r\n"]
[113337.57272, "o", "\r\nTASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[113337.806051, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[113337.806128, "o", "\r\n"]
[113337.939923, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[113338.071969, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[113338.199904, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[113338.329518, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/etc/gitea', 'owner': 'root', 'group': 'git'})\u001b[0m\r\n"]
[113338.330469, "o", "\r\nTASK [Ensure app.ini exists.] **********************************************************************************************************************************************************\r\n"]
[113338.557399, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m\r\n"]
[113338.687998, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'PATH', 'value': '/var/lib/gitea/data/gitea.db'})\u001b[0m\r\n"]
[113338.826812, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'actions', 'option': 'ENABLED', 'value': 'true'})\u001b[0m\r\n\r\nTASK [Create service file to start Gitea automatically] ********************************************************************************************************************************\r\n"]
[113339.272179, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
