[122636.202412, "o", "\r\n"]
[122636.33594, "o", "\r\nPLAY [Setup Gitea] *********************************************************************************************************************************************************************"]
[122636.335999, "o", "\r\n"]
[122636.337615, "o", "\r\n"]
[122636.337729, "o", "TASK [Gathering Facts] *****************************************************************************************************************************************************************"]
[122636.337778, "o", "\r\n"]
[122636.98811, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122636.990205, "o", "\r\nTASK [Update apt cache if needed.] *****************************************************************************************************************************************************\r\n"]
[122637.683664, "o", "\u001b[0;32mok: [localhost]\u001b[0m"]
[122637.685209, "o", "\r\n"]
[122637.687587, "o", "\r\n"]
[122637.687661, "o", "TASK [Install Gitea dependencies.] *****************************************************************************************************************************************************"]
[122637.687731, "o", "\r\n"]
[122638.517465, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122638.519814, "o", "\r\nTASK [Ensure git user exists.] *********************************************************************************************************************************************************\r\n"]
[122638.798091, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\n"]
[122638.802324, "o", "TASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[122639.034782, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[122639.163343, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[122639.163494, "o", "\r\n"]
[122639.298652, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[122639.430055, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[122639.430271, "o", "\r\n"]
[122639.558661, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/etc/gitea', 'owner': 'root', 'group': 'git'})\u001b[0m\r\n"]
[122639.56287, "o", "\r\nTASK [Ensure app.ini exists.] **********************************************************************************************************************************************************\r\n"]
[122639.791019, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m\r\n"]
[122639.923007, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'PATH', 'value': '/var/lib/gitea/data/gitea.db'})\u001b[0m\r\n"]
[122640.055831, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'actions', 'option': 'ENABLED', 'value': 'true'})\u001b[0m\r\n"]
[122640.18174, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'security', 'option': 'INSTALL_LOCK', 'value': 'true'})\u001b[0m\r\n"]
[122640.186727, "o", "\r\nTASK [Create service file to start Gitea automatically] ********************************************************************************************************************************\r\n"]
[122640.542932, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122640.544605, "o", "\r\nTASK [Download Gitea binary.] **********************************************************************************************************************************************************\r\n"]
[122640.909716, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122640.909757, "o", "\r\nTASK [Start and enable Gitea systemd Service.] *****************************************************************************************************************************************\r\n"]
[122641.440783, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122641.442434, "o", "\r\nTASK [Wait for Gitea to finish starting.] **********************************************************************************************************************************************\r\n"]
[122646.700104, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122646.707545, "o", "\r\nTASK [Download Gitea Runner binary.] ***************************************************************************************************************************************************\r\n"]
[122646.936615, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122646.938307, "o", "\r\nTASK [Create gitea runner directory.] **************************************************************************************************************************************************\r\n"]
