[122195.000977, "o", "\r\u001b[23;2t\u001b[23;1t\r\r\n\u001b[?1004l\u001b[?2004l\u001b[?1l\u001b>\u001b[?1049l\u001b[23;0;0t\u001b[?25h\u001b[>4;m"]
[122195.003946, "o", "\u001b[?2004h(.venv) \u001b]0;parallels@debian-13-6: ~/COMP590Fall2026/LABS/ian_milin/Lab7\u0007\u001b[01;32mparallels@debian-13-6\u001b[00m:\u001b[01;34m~/COMP590Fall2026/LABS/ian_milin/Lab7\u001b[00m$ "]
[122195.70263, "o", "vi playbook.yml"]
[122196.127801, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\bansible-playbook -i hosts.ini playbook.yml -K"]
[122197.119467, "o", "\r\n\u001b[?2004l\r"]
[122197.310171, "o", "BECOME password: "]
[122204.269515, "o", "\r\n"]
[122204.373929, "o", "\r\nPLAY [Setup Gitea] *********************************************************************************************************************************************************************\r\n"]
[122204.379137, "o", "\r\nTASK [Gathering Facts] *****************************************************************************************************************************************************************\r\n"]
[122205.025924, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122205.030548, "o", "\r\nTASK [Update apt cache if needed.] *****************************************************************************************************************************************************\r\n"]
[122205.704014, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122205.704934, "o", "\r\nTASK [Install Gitea dependencies.] *****************************************************************************************************************************************************\r\n"]
[122206.419586, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Ensure git user exists.] *********************************************************************************************************************************************************\r\n"]
[122206.680181, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[122206.909928, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[122207.041687, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[122207.171421, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[122207.300079, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[122207.300212, "o", "\r\n"]
[122207.431715, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/etc/gitea', 'owner': 'root', 'group': 'git'})\u001b[0m\r\n"]
[122207.43577, "o", "\r\nTASK [Ensure app.ini exists.] **********************************************************************************************************************************************************\r\n"]
[122207.662062, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m"]
[122207.66221, "o", "\r\n"]
[122207.792982, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'PATH', 'value': '/var/lib/gitea/data/gitea.db'})\u001b[0m"]
[122207.793134, "o", "\r\n"]
[122207.927962, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'actions', 'option': 'ENABLED', 'value': 'true'})\u001b[0m\r\n"]
[122208.057138, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'security', 'option': 'INSTALL_LOCK', 'value': 'true'})\u001b[0m\r\n"]
[122208.05718, "o", "\r\nTASK [Create service file to start Gitea automatically] ********************************************************************************************************************************\r\n"]
[122208.40432, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122208.405736, "o", "\r\nTASK [Download Gitea binary.] **********************************************************************************************************************************************************\r\n"]
[122208.755538, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Start and enable Gitea systemd Service.] *****************************************************************************************************************************************\r\n"]
[122209.264709, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122209.26614, "o", "\r\n"]
[122209.268083, "o", "TASK [Wait for Gitea to finish starting.] **********************************************************************************************************************************************\r\n"]
[122214.514998, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122214.520689, "o", "\r\nTASK [Download Gitea Runner binary.] ***************************************************************************************************************************************************\r\n"]
[122214.767922, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122214.769396, "o", "\r\nTASK [Create gitea runner directory.] **************************************************************************************************************************************************\r\n"]
