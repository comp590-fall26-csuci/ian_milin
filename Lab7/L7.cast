[125754.257217, "o", "\r\n\u001b[?2004l\r"]
[125754.453936, "o", "BECOME password: "]
[125758.880197, "o", "\r\n"]
[125759.008951, "o", "\r\nPLAY [Setup Gitea] *********************************************************************************************************************************************************************\r\n"]
[125759.013179, "o", "\r\nTASK [Gathering Facts] *****************************************************************************************************************************************************************\r\n"]
[125759.62948, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[125759.635376, "o", "\r\nTASK [Update apt cache if needed.] *****************************************************************************************************************************************************\r\n"]
[125762.469796, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[125762.474193, "o", "\r\nTASK [Install Gitea dependencies.] *****************************************************************************************************************************************************\r\n"]
[125763.205232, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[125763.206781, "o", "\r\nTASK [Ensure git user exists.] *********************************************************************************************************************************************************\r\n"]
[125763.471736, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[125763.701932, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[125763.831359, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[125763.832879, "o", "\r\n"]
[125763.965326, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[125763.968442, "o", "\r\n"]
[125764.098683, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[125764.101889, "o", "\r\n"]
[125764.229179, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/etc/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[125764.229249, "o", "\r\n"]
[125764.2348, "o", "\r\n"]
[125764.23488, "o", "TASK [Ensure app.ini exists.] **********************************************************************************************************************************************************\r\n"]
[125764.462711, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m\r\n"]
[125764.591744, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'PATH', 'value': '/var/lib/gitea/data/gitea.db'})\u001b[0m"]
[125764.59319, "o", "\r\n"]
[125764.72595, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'actions', 'option': 'ENABLED', 'value': 'true'})\u001b[0m\r\n"]
[125764.727233, "o", "\r\nTASK [Create service file to start Gitea automatically] ********************************************************************************************************************************\r\n"]
[125765.082166, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[125765.083775, "o", "\r\nTASK [Download Gitea binary.] **********************************************************************************************************************************************************\r\n"]
[125765.440012, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[125765.441892, "o", "\r\nTASK [Start and enable Gitea systemd Service.] *****************************************************************************************************************************************\r\n"]
[125765.951604, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[125765.955689, "o", "\r\nTASK [Wait for Gitea to finish starting.] **********************************************************************************************************************************************\r\n"]
[125771.216136, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[125771.218316, "o", "\r\nTASK [Download Gitea Runner binary.] ***************************************************************************************************************************************************\r\n"]
[125771.459644, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[125771.463098, "o", "\r\nTASK [Create gitea runner directory.] **************************************************************************************************************************************************\r\n"]
[125771.642577, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[125771.644272, "o", "\r\nTASK [Check if Gitea Runner is already registered.] ************************************************************************************************************************************\r\n"]
[125771.828432, "o", "\u001b[0;32mok: [localhost]\u001b[0m"]
[125771.831786, "o", "\r\n\r\n"]
[125771.831987, "o", "TASK [Generate Gitea Runner token.] ****************************************************************************************************************************************************"]
[125771.83207, "o", "\r\n"]
[125771.844385, "o", "\u001b[0;36mskipping: [localhost]\u001b[0m\r\n"]
[125771.847945, "o", "\r\nTASK [Register Gitea Runner to run on the host OS] *************************************************************************************************************************************"]
[125771.84811, "o", "\r\n"]
[125771.855852, "o", "\u001b[0;36mskipping: [localhost]\u001b[0m\r\n"]
