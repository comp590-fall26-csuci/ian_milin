[122190.9447, "o", "\u001b[?25l\u001b[27;52r\u001b[52;1H\r\n\u001b[1;53r\u001b[27;3H\u001b[93m8\u001b[m\u001b[1C        sudo -u git GITEA_WORK_DIR={{ gitea_home }} {{ gitea_path }} --config /etc/gitea/app.ini actions generate-runner-token\u001b[28;2H\u001b[93m29\r\n130\r\n131\r\n132\r\n133\r\n134\r\n135\r\n136\r\n137\r\n138\r\n139\r\n140\r\n141\r\n142\r\n143\r\n144\r\n145\r\n146\r\n147\r\n148\r\n149\r\n150\r\n151\r\n152\u001b[m\r\n\u001b[94m~                                                                                                                                                                                       \u001b[m\u001b[53;167H\u001b[K\u001b[53;167H128,70\u001b[8CBot\u001b[27;74H\u001b[?25h"]
