[123423.404011, "o", "\r\n"]
[123423.553414, "o", "\r\nPLAY [Setup Gitea] *********************************************************************************************************************************************************************\r\n"]
[123423.558411, "o", "\r\nTASK [Gathering Facts] *****************************************************************************************************************************************************************\r\n"]
[123424.221085, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[123424.223166, "o", "\r\nTASK [Update apt cache if needed.] *****************************************************************************************************************************************************\r\n"]
[123426.503301, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Install Gitea dependencies.] *****************************************************************************************************************************************************\r\n"]
[123427.232725, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[123427.235996, "o", "\r\nTASK [Ensure git user exists.] *********************************************************************************************************************************************************\r\n"]
[123427.501867, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[123427.503249, "o", "\r\nTASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[123427.733024, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[123427.860443, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[123427.988412, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[123427.989922, "o", "\r\n"]
[123428.119303, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[123428.250745, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/etc/gitea', 'owner': 'root', 'group': 'git'})\u001b[0m\r\n"]
[123428.254797, "o", "\r\nTASK [Ensure app.ini exists.] **********************************************************************************************************************************************************\r\n"]
[123428.484096, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m\r\n"]
[123428.612249, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'PATH', 'value': '/var/lib/gitea/data/gitea.db'})\u001b[0m\r\n"]
[123428.741782, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'actions', 'option': 'ENABLED', 'value': 'true'})\u001b[0m\r\n"]
[123428.889433, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'security', 'option': 'INSTALL_LOCK', 'value': 'true'})\u001b[0m"]
[123428.893134, "o", "\r\n"]
[123428.896126, "o", "\r\nTASK [Create service file to start Gitea automatically] ********************************************************************************************************************************\r\n"]
[123429.256498, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
