[136428.095938, "o", "\u001b[?2004h(.venv) \u001b]0;parallels@debian-13-6: ~/COMP590Fall2026/LABS/ian_milin/Lab7\u0007\u001b[01;32mparallels@debian-13-6\u001b[00m:\u001b[01;34m~/COMP590Fall2026/LABS/ian_milin/Lab7\u001b[00m$ "]
[136429.086519, "o", "vi playbook.yml"]
[136429.514146, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\becho $ASCIINEMA_REC"]
[136430.459055, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\bansible-playbook -i hosts.ini playbook.yml -K"]
[136434.946612, "o", "\r\n"]
[136434.952455, "o", "\u001b[?2004l\r"]
[136435.305558, "o", "BECOME password: "]
[136439.806457, "o", "\r\n"]
[136439.957531, "o", "\r\nPLAY [Setup Gitea] *********************************************************************************************************************************************************************\r\n"]
[136439.967188, "o", "\r\nTASK [Gathering Facts] *****************************************************************************************************************************************************************\r\n"]
[136440.723725, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[136440.728613, "o", "\r\nTASK [Update apt cache if needed.] *****************************************************************************************************************************************************\r\n"]
[136445.907953, "o", "\u001b[0;33mchanged: [localhost]\u001b[0m\r\n"]
[136445.912053, "o", "\r\nTASK [Install Gitea dependencies.] *****************************************************************************************************************************************************\r\n"]
[136446.69944, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[136446.702594, "o", "\r\nTASK [Ensure git user exists.] *********************************************************************************************************************************************************\r\n"]
[136446.985291, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[136446.989811, "o", "\r\nTASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[136447.238359, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[136447.370881, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[136447.502533, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[136447.636756, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[136447.641457, "o", "\r\nTASK [Ensure app.ini exists.] **********************************************************************************************************************************************************\r\n"]
[136447.872235, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m"]
[136447.872411, "o", "\r\n"]
[136448.003513, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'PATH', 'value': '/var/lib/gitea/data/gitea.db'})\u001b[0m\r\n"]
[136448.131573, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'actions', 'option': 'ENABLED', 'value': 'true'})\u001b[0m\r\n"]
[136448.133431, "o", "\r\nTASK [Create service file to start Gitea automatically] ********************************************************************************************************************************\r\n"]
[136448.521275, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[136448.522343, "o", "\r\nTASK [Download Gitea binary.] **********************************************************************************************************************************************************\r\n"]
[136449.074192, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[136449.075952, "o", "\r\nTASK [Start and enable Gitea systemd Service.] *****************************************************************************************************************************************\r\n"]
[136449.661381, "o", "\u001b[0;32mok: [localhost]\u001b[0m"]
[136449.663966, "o", "\r\n"]
[136449.664773, "o", "\r\n"]
[136449.664875, "o", "TASK [Wait for Gitea to finish starting.] **********************************************************************************************************************************************"]
[136449.664979, "o", "\r\n"]
[136454.923784, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[136454.928759, "o", "\r\nTASK [Download Gitea Runner binary.] ***************************************************************************************************************************************************\r\n"]
[136455.179983, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[136455.181265, "o", "\r\nTASK [Create gitea runner directory.] **************************************************************************************************************************************************\r\n"]
[136455.375291, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[136455.376664, "o", "\r\nTASK [Check if Gitea Runner is already registered.] ************************************************************************************************************************************\r\n"]
[136455.560865, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[136455.565288, "o", "\r\nTASK [Generate Gitea Runner token.] ****************************************************************************************************************************************************\r\n"]
[136455.574522, "o", "\u001b[0;36mskipping: [localhost]\u001b[0m\r\n"]
[136455.582111, "o", "\r\nTASK [Register Gitea Runner to run on the host OS] *************************************************************************************************************************************"]
[136455.582479, "o", "\r\n"]
[136455.596368, "o", "\u001b[0;36mskipping: [localhost]\u001b[0m\r\n"]
[136455.599621, "o", "\r\nTASK [Create service file for Gitea Runner] ********************************************************************************************************************************************\r\n"]
[136456.024108, "o", "\u001b[0;33mchanged: [localhost]\u001b[0m"]
[136456.027506, "o", "\r\n\r\nTASK [Start and enable Gitea Runner Service] *******************************************************************************************************************************************\r\n"]
[136456.560942, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[136456.565343, "o", "\r\nRUNNING HANDLER [reload systemd] *******************************************************************************************************************************************************\r\n"]
[136456.996654, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[136456.999405, "o", "\r\nPLAY RECAP *****************************************************************************************************************************************************************************\r\n\u001b[0;33mlocalhost\u001b[0m                  : \u001b[0;32mok=16  \u001b[0m \u001b[0;33mchanged=2   \u001b[0m unreachable=0    failed=0    \u001b[0;36mskipped=2   \u001b[0m rescued=0    ignored=0   \r\n\r\n"]
