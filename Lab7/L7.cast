[124848.803098, "o", "\u001b[1;1H\u001b[93m111\u001b[m\u001b[7C  \u001b[1m\u001b[96mchecksum\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m\"{{ runner_checksum }}\"\u001b[m\r\n\u001b[93m112\u001b[m\u001b[2;13H\u001b[K\u001b[3;1H\u001b[93m113\u001b[m\u001b[5C\u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Create gitea runner directory.\r\n\u001b[93m114\u001b[m\u001b[7C\u001b[1m\u001b[96mfile\u001b[m\u001b[38;5;224m:\u001b[m\u001b[4;16H\u001b[K\u001b[5;1H\u001b[93m115\u001b[m\u001b[9C\u001b[1m\u001b[96mpath\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m\"{{ runner_home\u001b[m\r\n\u001b[93m116\u001b[m\u001b[9C\u001b[1m\u001b[96mstate\u001b[m\u001b[38;5;224m:\u001b[m directory\r\n\u001b[93m117\u001b[m\u001b[7C  \u001b[1m\u001b[96mowner\u001b[m\u001b[38;5;224m:\u001b[m root\r\n\u001b[93m118\u001b[m\u001b[9C\u001b[1m\u001b[96mgrou\u001b[m\u001b[1C\u001b[38;5;224m:\u001b[m root\u001b[8;24H\u001b[K\u001b[9;1H\u001b[93m119\u001b[m\u001b[9C\u001b[1m\u001b[96mmode\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m0755\u001b[m\u001b[9;23H\u001b[K\u001b[10;1H\u001b[93m120\u001b[m\u001b[10;13H\u001b[K\u001b[11;1H\u001b[93m121\u001b[m\u001b[5C\u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Force pending handlers to run now\u001b[11;50H\u001b[K\u001b[12;1H\u001b[93m122\u001b[m\u001b[7C\u001b[1m\u001b[96mmeta\u001b[m\u001b[38;5;224m:\u001b[m flush_handlers\u001b[12;31H\u001b[K\u001b[13;1H\u001b[93m123\r\n124\u001b[m\u001b[13CWait for Gitea to come back online after restart\r\n\u001b[93m125\u001b[m\u001b[7C\u001b[1m\u001b[96mwait_for\u001b[m\u001b[38;5;224m:\u001b[m\r\n\u001b[93m126\u001b[m\u001b[10C\u001b[1m\u001b[96mort\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m3000\u001b[m\u001b[16;23H\u001b[K\u001b[17;1H\u001b[93m127\u001b[m\u001b[9C\u001b[1m\u001b[96mdelay\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m5\u001b[m\u001b[17;22H\u001b[K\u001b[18;1H\u001b[93m128\u001b[m\u001b[9C\u001b[1m\u001b[96mtimeout\u001b[m\u001b[38;5;224m:\u001b[m \u00