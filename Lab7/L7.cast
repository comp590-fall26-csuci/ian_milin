[120966.422481, "o", "\u001b[?25l\u001b[1;52r\u001b[1;1H\u001b[6L\u001b[1;53r\u001b[1;1H\u001b[93m 66 \u001b[m\u001b[8C\u001b[1m\u001b[96mdest\u001b[m\u001b[38;5;224m:\u001b[m /etc/systemd/system/gitea.service\r\n\u001b[93m 67 \u001b[m\u001b[8C\u001b[1m\u001b[96mcontent\u001b[m\u001b[38;5;224m:\u001b[m \u001b[38;5;224m|\u001b[m\r\n\u001b[93m 68 \u001b[m\u001b[10C[Unit]\r\n\u001b[93m 69 \u001b[m\u001b[10CDescription=Gitea (Git with a cup of tea)\r\n\u001b[93m 70 \u001b[m\u001b[10CAfter=syslog.target network.target\r\n\u001b[93m 71 \u001b[m\u001b[10C[Service]\u001b[53;167H\u001b[K\u001b[53;167H66,34\u001b[9C65%\u001b[1;38H\u001b[?25h"]
