[122794.640694, "o", "BECOME password: "]
[122799.477, "o", "\r\n"]
[122799.611837, "o", "\r\nPLAY [Setup Gitea] *********************************************************************************************************************************************************************\r\n"]
[122799.616264, "o", "\r\nTASK [Gathering Facts] *****************************************************************************************************************************************************************\r\n"]
[122800.236401, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122800.240191, "o", "\r\nTASK [Update apt cache if needed.] *****************************************************************************************************************************************************\r\n"]
[122800.912302, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122800.91467, "o", "\r\nTASK [Install Gitea dependencies.] *****************************************************************************************************************************************************\r\n"]
[122801.629524, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122801.630951, "o", "\r\nTASK [Ensure git user exists.] *********************************************************************************************************************************************************\r\n"]
[122801.895255, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[122802.12496, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[122802.252839, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[122802.380857, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[122802.51246, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[122802.642593, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/etc/gitea', 'owner': 'root', 'group': 'git'})\u001b[0m\r\n"]
[122802.642631, "o", "\r\n"]
[122802.642771, "o", "TASK [Ensure app.ini exists.] **********************************************************************************************************************************************************"]
[122802.642817, "o", "\r\n"]
[122802.870325, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m"]
[122802.871808, "o", "\r\n"]
[122803.001873, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'PATH', 'value': '/var/lib/gitea/data/gitea.db'})\u001b[0m"]
[122803.001984, "o", "\r\n"]
[122803.136338, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'actions', 'option': 'ENABLED', 'value': 'true'})\u001b[0m"]
[122803.13638, "o", "\r\n"]
[122803.266169, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'security', 'option': 'INSTALL_LOCK', 'value': 'true'})\u001b[0m\r\n"]
[122803.269253, "o", "\r\nTASK [Create service file to start Gitea automatically] ********************************************************************************************************************************\r\n"]
[122803.623342, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122803.626609, "o", "\r\nTASK [Download Gitea binary.] **********************************************************************************************************************************************************\r\n"]
[122803.985426, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122803.987029, "o", "\r\n"]
[122803.988535, "o", "TASK [Start and enable Gitea systemd Service.] *****************************************************************************************************************************************"]
[122803.988575, "o", "\r\n"]
[122804.518377, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Wait for Gitea to finish starting.] **********************************************************************************************************************************************\r\n"]
[122809.784229, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
