[126183.631423, "o", "\u001b[1;1H\u001b[38;5;130m  1 -\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Setup Gitea\r\n\u001b[38;5;130m  2 \u001b[m  \u001b[36mhosts\u001b[m\u001b[35m:\u001b[m targets\u001b[2;21H\u001b[K\u001b[3;1H\u001b[38;5;130m  3 \u001b[m  \u001b[36mbecome\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\u001b[3;19H\u001b[K\u001b[4;1H\u001b[38;5;130m  4 \u001b[m  \u001b[36mvars\u001b[m\u001b[35m:\u001b[m\r\n\u001b[38;5;130m  5 \u001b[m    \u001b[36mgitea_path\u001b[m\u001b[35m:\u001b[m /usr/local/bin/gitea\r\n\u001b[38;5;130m  6 \u001b[m    \u001b[36mgitea_version\u001b[m\u001b[35m:\u001b[m 28.3.0\r\n\u001b[38;5;130m  7 \u001b[m    \u001b[36mgitea_checksum\u001b[m\u001b[35m:\u001b[m sha256:24d146e8f5c986b86e5a3311e3ec349ded35202cba056952ab5b585511ace82d\r\n\u001b[38;5;130m  8 \u001b[m    \u001b[36mgitea_home\u001b[m\u001b[35m:\u001b[m /var/lib/gitea\r\n\u001b[38;5;130m  9 \r\n 10 \u001b[m    \u001b[36mrunner_path\u001b[m\u001b[35m:\u001b[m /usr/local/bin/gitea-runner\r\n\u001b[38;5;130m 11 \u001b[m    \u001b[36mrunner_version\u001b[m\u001b[35m:\u001b[m 5.4.1\r\n\u001b[38;5;130m 12 \u001b[m    \u001b[36mrunner_checksum\u001b[m\u001b[35m:\u001b[m sha256:3ba021458e7a7ea4e8b685451caaea77de0e1aeaca1448d2501c46ec270eae1e\r\n\u001b[38;5;130m 13 \u001b[m    \u001b[36mrunner_home\u001b[m\u001b[35m:\u001b[m /var/lib/gitea-runner\r\n\u001b[38;5;130m 14 \r\n 15 \u001b[m  \u001b[36mpre_tasks\u001b[m\u001b[35m:\u001b[m\r\n\u001b[38;5;130m 16 \u001b[m    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Update apt cache if needed.\r\n\u001b[38;5;130m 17 \u001b[m      \u001b[36mapt\u001b[m\u001b[35m:\u001b[m update_cache=yes cache_valid_time=3600\r\n\u001b[38;5;130m 18 \r\n 19 \u001b[m  \u001b[36mtasks\u001b[m\u001b[35m:\u001b[m\r\n\u001b[38;5;130m 20 \u001b[m    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Install Gitea dependencies.\r\n\u001b[38;5;130m 21 \u001b[m      \u001b[36mapt\u001b[m\u001b[35m:\u001b[m\r\n\u001b[38;5;130m 22 \u001b[m\u001b[8C\u001b[36mstate\u001b[m\u001b[35m:\u001b[m present\r\n\u001b[38;5;130m 23 \u001b[m\u001b[8C\u001b[36mname\u001b[m\u001b[35m:\u001b[m\r\n\u001b[38;5;130m 24 \u001b[10C-\u001b[m git\r\n\u001b[38;5;130m 25 \u001b[10C-\u001b[m sqlite3\r\n\u001b[38;5;130m 26 \r\n 27 \u001b[m    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Ensure git user exists.\r\n\u001b[38;5;130m 28 \u001b[m      \u001b[36muser\u001b[m\u001b[35m:\u001b[m\r\n\u001b[38;5;130m 29 \u001b[m\u001b[8C\u001b[36mname\u001b[m\u001b[35m:\u001b[m git\r\n\u001b[38;5;130m 30 \u001b[m\u001b[8C\u001b[36msystem\u001b[m\u001b[35m:\u001b[m \u001b[31mtrue\u001b[m\r\n\u001b[38;5;130m 31 \u001b[m\u001b[8C\u001b[36mcomment\u001b[m\u001b[35m:\u001b[m \u001b[31m'Git Version Control'\u001b[m\r\n\u001b[38;5;130m 32 \u001b[m\u001b[8C\u001b[36mhome\u001b[m\u001b[35m:\u001b[m \u001b[31m'/home/git'\u001b[m\r\n\u001b[38;5;130m 33 \u001b[m\u001b[8C\u001b[36mstate\u001b[m\u001b[35m:\u001b[m present\r\n\u001b[38;5;130m 34 \r\n 35 \u001b[m    \u001b[38;5;130m-"]
[126183.634378, "o", "\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Ensure required directory structure exists.\r\n\u001b[38;5;130m 36 \u001b[m      \u001b[36mfile\u001b[m\u001b[35m:\u001b[m\r\n\u001b[38;5;130m 37 \u001b[m\u001b[8C\u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{ item.path }}\"\u001b[m\r\n\u001b[38;5;130m 38 \u001b[m\u001b[8C\u001b[36mstate\u001b[m\u001b[35m:\u001b[m directory\r\n\u001b[38;5;130m 39 \u001b[m\u001b[8C\u001b[36mowner\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{ item.owner }}\"\u001b[m\r\n\u001b[38;5;130m 40 \u001b[m\u001b[8C\u001b[36mgroup\u001b[m\u001b[35m:\u001b[m \u001b[31m\"{{ item.group }}\"\u001b[m\r\n\u001b[38;5;130m 41 \u001b[m\u001b[8C\u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m0750\u001b[m\r\n\u001b[38;5;130m 42 \u001b[m      \u001b[36mloop\u001b[m\u001b[35m:\u001b[m\r\n\u001b[38;5;130m 43 \u001b[8C-\u001b[m \u001b[35m{\u001b[m \u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m'{{ gitea_home }}'\u001b[m, \u001b[36mowner\u001b[m\u001b[35m:\u001b[m \u001b[31m'git'\u001b[m, \u001b[36mgroup\u001b[m\u001b[35m:\u001b[m \u001b[31m'git'\u001b[m \u001b[35m}\u001b[m\r\n\u001b[38;5;130m 44 \u001b[8C-\u001b[m \u001b[35m{\u001b[m \u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m'{{ gitea_home }}/custom'\u001b[m, \u001b[36mowner\u001b[m\u001b[35m:\u001b[m \u001b[31m'git'\u001b[m, \u001b[36mgroup\u001b[m\u001b[35m:\u001b[m \u001b[31m'git'\u001b[m \u001b[35m}\u001b[m\r\n\u001b[38;5;130m 45 \u001b[8C-\u001b[m \u001b[35m{\u001b[m \u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m'{{ gitea_home }}/data'\u001b[m, \u001b[36mowner\u001b[m\u001b[35m:\u001b[m \u001b[31m'git'\u001b[m, \u001b[36mgroup\u001b[m\u001b[35m:\u001b[m \u001b[31m'git'\u001b[m \u001b[35m}\u001b[m\r\n\u001b[38;5;130m 46 \u001b[8C-\u001b[m \u001b[35m{\u001b[m \u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m'{{ gitea_home }}/log'\u001b[m, \u001b[36mowner\u001b[m\u001b[35m:\u001b[m \u001b[31m'git'\u001b[m, \u001b[36mgroup\u001b[m\u001b[35m:\u001b[m \u0