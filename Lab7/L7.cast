[110048.585352, "o", "\r\n"]
[110048.732354, "o", "\r\nPLAY [Setup Gitea] *********************************************************************************************************************************************************************\r\n"]
[110048.736964, "o", "\r\nTASK [Gathering Facts] *****************************************************************************************************************************************************************\r\n"]
[110049.420507, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[110049.422741, "o", "\r\nTASK [Update apt cache if needed.] *****************************************************************************************************************************************************\r\n"]
[110052.680525, "o", "\u001b[0;33mchanged: [localhost]\u001b[0m\r\n\r\nTASK [Install Gitea dependencies.] *****************************************************************************************************************************************************\r\n"]
[110053.423994, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[110053.424255, "o", "\r\nTASK [Ensure git user exists.] *********************************************************************************************************************************************************\r\n"]
[110053.694031, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[110053.695502, "o", "\r\nTASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[110053.927137, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[110054.062815, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[110054.062973, "o", "\r\n"]
[110054.195275, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[110054.196816, "o", "\r\n"]
[110054.327197, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[110054.459961, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/etc/gitea', 'owner': 'root', 'group': 'git'})\u001b[0m\r\n"]
[110054.461156, "o", "\r\nTASK [Ensure app.ini exists.] **********************************************************************************************************************************************************\r\n"]
[110054.693964, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m"]
[110054.694102, "o", "\r\n"]
[110054.831027, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'PATH', 'value': '/var/lib/gitea/data/gitea.db'})\u001b[0m"]
[110054.831062, "o", "\r\n"]
[110054.967366, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'actions', 'option': 'ENABLED', 'value': 'true'})\u001b[0m\r\n"]
[110054.972527, "o", "\r\nTASK [Create service file to start Gitea automatically] ********************************************************************************************************************************\r\n"]
[110055.364997, "o", "\u001b[0;32mok: [localhost]\u001b[0m"]
[110055.368349, "o", "\r\n\r\nTASK [Download Gitea binary.] **********************************************************************************************************************************************************\r\n"]
