[132196.806024, "o", "BECOME password: "]
[132200.884043, "o", "\r\n"]
[132201.034182, "o", "\r\nPLAY [Setup Gitea] *********************************************************************************************************************************************************************\r\n"]
[132201.040361, "o", "\r\nTASK [Gathering Facts] *****************************************************************************************************************************************************************\r\n"]
[132201.858489, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Update apt cache if needed.] *****************************************************************************************************************************************************\r\n"]
[132205.392455, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[132205.397948, "o", "\r\nTASK [Install Gitea dependencies.] *****************************************************************************************************************************************************\r\n"]
[132206.246902, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[132206.249176, "o", "\r\nTASK [Ensure git user exists.] *********************************************************************************************************************************************************\r\n"]
[132206.556546, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[132206.558029, "o", "\r\nTASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[132206.794346, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[132206.936431, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[132206.940212, "o", "\r\n"]
[132207.077565, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[132207.210456, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n\r\nTASK [Ensure app.ini exists.] **********************************************************************************************************************************************************\r\n"]
[132207.445462, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m"]
[132207.44564, "o", "\r\n"]
[132207.579787, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'PATH', 'value': '/var/lib/gitea/data/gitea.db'})\u001b[0m\r\n"]
[132207.707962, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'actions', 'option': 'ENABLED', 'value': 'true'})\u001b[0m\r\n"]
[132207.712853, "o", "\r\nTASK [Create service file to start Gitea automatically] ********************************************************************************************************************************\r\n"]
[132208.108142, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[132208.108886, "o", "\r\nTASK [Download Gitea binary.] **********************************************************************************************************************************************************\r\n"]
[132208.743206, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[132208.744674, "o", "\r\nTASK [Start and enable Gitea systemd Service.] *****************************************************************************************************************************************\r\n"]
[132209.304394, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[132209.307958, "o", "\r\nTASK [Wait for Gitea to finish starting.] **********************************************************************************************************************************************\r\n"]
[132214.570074, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[132214.580538, "o", "\r\nTASK [Download Gitea Runner binary.] ***************************************************************************************************************************************************\r\n"]
[132214.843023, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Create gitea runner directory.] **************************************************************************************************************************************************\r\n"]
[132215.032007, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Check if Gitea Runner is already registered.] ************************************************************************************************************************************\r\n"]
[132215.219227, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[132215.223426, "o", "\r\nTASK [Generate Gitea Runner token.] ****************************************************************************************************************************************************\r\n"]
[132215.50786, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[132215.509462, "o", "\r\nTASK [Register Gitea Runner to run on the host OS] *************************************************************************************************************************************\r\n"]
[132215.701459, "o", "\u001b[0;33mchanged: [localhost]\u001b[0m\r\n"]
[132215.703053, "o", "\r\nTASK [Create service file for Gitea Runner] ********************************************************************************************************************************************\r\n"]
[132216.010886, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Start and enable Gitea Runner Service] *******************************************************************************************************************************************\r\n"]
[132216.544138, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
