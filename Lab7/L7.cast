[124847.718982, "o", "\u001b[37;24H\u001b[K\u001b[38;1H\u001b[93m 73\u001b[m\u001b[9C  RestartSec=2s\r\n\u001b[93m 74\u001b[m\u001b[9C  Type=simple\r\n\u001b[93m 75\u001b[m\u001b[9C  User=git\u001b[40;23H\u001b[K\u001b[41;1H\u001b[93m 76\u001b[m\u001b[7C    Group=git\r\n\u001b[93m 77\u001b[m\u001b[9C  WorkingDirectory={{ gitea_home }}\u001b[42;48H\u001b[K\u001b[43;1H\u001b[93m 78\u001b[m\u001b[9C  ExecStart={{ gitea_path }} web -c /etc/gitea/app.ini\r\n\u001b[93m 79\u001b[m\u001b[11CRestart=always\r\n\u001b[93m 80\u001b[m\u001b[3C        Environment=USER=git HOME=/home/git GITEA_WORK_DIR=/var/lib/gitea\r\n\u001b[93m 81\u001b[m\u001b[5C      [Install]\u001b[46;25H\u001b[K\u001b[47;1H\u001b[93m 82\u001b[m\u001b[7C    WantedBy=multi-user.target\r\n\u001b[93m 83\u001b[m\u001b[9C\u001b[1m\u001b[96mmode\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m0644\u001b[m\u001b[48;23H\u001b[K\u001b[49;1H\u001b[93m 84\u001b[m\u001b[7C\u001b[1m\u001b[96mnotify\u001b[m\u001b[38;5;224m:\u001b[m reload systemd\r\n\u001b[93m 85\r\n 86\u001b[m\u001b[13CDownload Gitea binary.\r\n\u001b[93m 87\u001b[m\u001b[7C\u001b[1m\u001b[96mget_url\u001b[m\u001b[38;5;224m:\u001b[m\u001b[53;167H61,23\u001b[9C29%\u001b[53;167H\u001b[K\u001b[53;167H61,23\u001b[9C29%\u001b[26;27H\u001b[?25h"]
