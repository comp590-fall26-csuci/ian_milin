[125269.317804, "o", "BECOME password: "]
[125274.308014, "o", "\r\n"]
[125274.455917, "o", "\r\nPLAY [Setup Gitea] *********************************************************************************************************************************************************************\r\n"]
[125274.460712, "o", "\r\nTASK [Gathering Facts] *****************************************************************************************************************************************************************\r\n"]
[125275.123977, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[125275.128077, "o", "\r\nTASK [Update apt cache if needed.] *****************************************************************************************************************************************************\r\n"]
[125278.302764, "o", "\u001b[0;32mok: [localhost]\u001b[0m"]
[125278.304055, "o", "\r\n"]
[125278.308309, "o", "\r\nTASK [Install Gitea dependencies.] *****************************************************************************************************************************************************\r\n"]
[125279.123706, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[125279.125461, "o", "\r\nTASK [Ensure git user exists.] *********************************************************************************************************************************************************\r\n"]
[125279.395661, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[125279.399458, "o", "\r\nTASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[125279.628018, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[125279.767541, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[125279.896898, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[125280.028274, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[125280.028416, "o", "\r\n"]
[125280.164087, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/etc/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[125280.164224, "o", "\r\n"]
[125280.166523, "o", "\r\n"]
[125280.166613, "o", "TASK [Ensure app.ini exists.] **********************************************************************************************************************************************************"]
[125280.16666, "o", "\r\n"]
[125280.395524, "o", "\u001b[0;33mchanged: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m"]
[125280.395676, "o", "\r\n"]
[125280.529206, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'PATH', 'value': '/var/lib/gitea/data/gitea.db'})\u001b[0m\r\n"]
[125280.657875, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'actions', 'option': 'ENABLED', 'value': 'true'})\u001b[0m\r\n"]
[125280.788667, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'security', 'option': 'INSTALL_LOCK', 'value': 'true'})\u001b[0m\r\n"]
[125280.793108, "o", "\r\nTASK [Create service file to start Gitea automatically] ********************************************************************************************************************************\r\n"]
[125281.147192, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Download Gitea binary.] **********************************************************************************************************************************************************\r\n"]
[125281.508031, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Start and enable Gitea systemd Service.] *****************************************************************************************************************************************\r\n"]
[125282.028707, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[125282.030139, "o", "\r\nTASK [Wait for Gitea to finish starting.] **********************************************************************************************************************************************\r\n"]
[125287.284854, "o", "\u001b[0;32mok: [localhost]\u001b[0m"]
[125287.288021, "o", "\r\n\r\nTASK [Download Gitea Runner binary.] ***************************************************************************************************************************************************\r\n"]
[125287.541884, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
