[123275.586366, "o", "\u001b[?25l\u001b[1;52r\u001b[1;1H\u001b[6M\u001b[1;53r\u001b[47;1H\u001b[93m116 \u001b[m\u001b[8C\u001b[1m\u001b[96mstate\u001b[m\u001b[38;5;224m:\u001b[m directory\r\n\u001b[93m117 \u001b[m\u001b[8C\u001b[1m\u001b[96mowner\u001b[m\u001b[38;5;224m:\u001b[m root\r\n\u001b[93m118 \u001b[m\u001b[8C\u001b[1m\u001b[96mgroup\u001b[m\u001b[38;5;224m:\u001b[m root\r\n\u001b[93m119 \u001b[m\u001b[8C\u001b[1m\u001b[96mmode\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m0755\u001b[m\r\n\u001b[93m120 \r\n121 \u001b[m    \u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Check if Gitea Runner is already registered.\u001b[53;167H\u001b[K\u001b[53;167H121,57\u001b[8C66%\u001b[52;61H\u001b[?25h"]
[123275.653136, "o", "\u001b[?25l\u001b[1;52r\u001b[1;1H\u001b[6M\u001b[1;53r\u001b[47;1H\u001b[93m122 \u001b[m      \u001b[1m\u001b[96mstat\u001b[m\u001b[38;5;224m:\u001b[m\r\n\u001b[93m123 \u001b[m\u001b[8C\u001b[1m\u001b[96mpath\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m\"{{ runner_home }}/.runner\"\u001b[m\r\n\u001b[93m124 \u001b[m      \u001b[1m\u001b[96mregister\u001b[m\u001b[38;5;224m:\u001b[m runner_reg\r\n\u001b[93m125 \r\n126 \u001b[m    \u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Generate Gitea Runner token.\r\n\u001b[93m127 \u001b[m      \u001b[1m\u001b[96mcommand\u001b[m\u001b[38;5;224m:\u001b[m \u001b[38;5;224m>\u001b[m\u001b[53;167H\u001b[K\u001b[53;167H127,17\u001b[8C72%\u001b[52;21H\u001b[?25h"]
