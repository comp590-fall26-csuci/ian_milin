[108664.635248, "o", "BECOME password: "]
[108668.025058, "o", "\r\n"]
[108668.17176, "o", "\r\nPLAY [Setup Gitea] *********************************************************************************************************************************************************************\r\n"]
[108668.174624, "o", "\r\nTASK [Gathering Facts] *****************************************************************************************************************************************************************\r\n"]
[108668.86885, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[108668.8707, "o", "\r\nTASK [Update apt cache if needed.] *****************************************************************************************************************************************************\r\n"]
[108669.588159, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[108669.589749, "o", "\r\nTASK [Install Gitea dependencies.] *****************************************************************************************************************************************************\r\n"]
[108670.315158, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[108670.320007, "o", "\r\nTASK [Ensure git user exists.] *********************************************************************************************************************************************************\r\n"]
[108670.587521, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[108670.588725, "o", "\r\nTASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[108670.823978, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[108670.953429, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[108671.091512, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[108671.219815, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[108671.351792, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/etc/gitea', 'owner': 'root', 'group': 'git'})\u001b[0m\r\n"]
[108671.353925, "o", "\r\n"]
[108671.354015, "o", "TASK [Ensure app.ini exists.] **********************************************************************************************************************************************************"]
[108671.354092, "o", "\r\n"]
[108671.584007, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m\r\n"]
[108671.728765, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'PATH', 'value': '/var/lib/gitea/data/gitea.db'})\u001b[0m\r\n"]
[108671.875972, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'actions', 'option': 'ENABLED', 'value': 'true'})\u001b[0m\r\n"]
[108671.882143, "o", "\r\nTASK [Create service file to start Gitea automatically] ********************************************************************************************************************************\r\n"]
[108672.342589, "o", "\u001b[0;33mchanged: [localhost]\u001b[0m\r\n"]
