[122152.968165, "o", "\r\nTASK [Install Gitea dependencies.] *****************************************************************************************************************************************************\r\n"]
[122153.699296, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122153.700848, "o", "\r\nTASK [Ensure git user exists.] *********************************************************************************************************************************************************\r\n"]
[122153.967925, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122153.967963, "o", "\r\nTASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[122154.199419, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[122154.326786, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[122154.456506, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[122154.459989, "o", "\r\n"]
[122154.58755, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[122154.719296, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/etc/gitea', 'owner': 'root', 'group': 'git'})\u001b[0m\r\n\r\nTASK [Ensure app.ini exists.] **********************************************************************************************************************************************************\r\n"]
[122154.945992, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m\r\n"]
