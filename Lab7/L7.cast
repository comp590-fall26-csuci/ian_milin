[127501.075795, "o", "\r\n\u001b[?2004l\r"]
[127501.299027, "o", "BECOME password: "]
[127504.783329, "o", "\r\n"]
[127504.927982, "o", "\r\nPLAY [Setup Gitea] *********************************************************************************************************************************************************************\r\n"]
[127504.929764, "o", "\r\nTASK [Gathering Facts] *****************************************************************************************************************************************************************\r\n"]
[127505.623094, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[127505.625525, "o", "\r\nTASK [Update apt cache if needed.] *****************************************************************************************************************************************************\r\n"]
[127508.947619, "o", "\u001b[0;32mok: [localhost]\u001b[0m"]
[127508.951966, "o", "\r\n\r\nTASK [Install Gitea dependencies.] *****************************************************************************************************************************************************\r\n"]
[127509.695979, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[127509.696188, "o", "\r\nTASK [Ensure git user exists.] *********************************************************************************************************************************************************\r\n"]
[127509.963688, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[127509.967628, "o", "\r\nTASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[127510.201423, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[127510.33078, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[127510.464268, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[127510.599598, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n\r\n"]
[127510.599734, "o", "TASK [Ensure app.ini exists.] **********************************************************************************************************************************************************"]
[127510.599799, "o", "\r\n"]
[127510.830672, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m\r\n"]
[127510.964647, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'PATH', 'value': '/var/lib/gitea/data/gitea.db'})\u001b[0m\r\n"]
[127511.095528, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'actions', 'option': 'ENABLED', 'value': 'true'})\u001b[0m\r\n"]
[127511.099544, "o", "\r\nTASK [Create service file to start Gitea automatically] ********************************************************************************************************************************\r\n"]
[127511.455956, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Download Gitea binary.] **********************************************************************************************************************************************************\r\n"]
[127511.816671, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[127511.818045, "o", "\r\nTASK [Start and enable Gitea systemd Service.] *****************************************************************************************************************************************\r\n"]
[127512.332236, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[127512.333523, "o", "\r\nTASK [Wait for Gitea to finish starting.] **********************************************************************************************************************************************\r\n"]
[127517.582154, "o", "\u001b[0;32mok: [localhost]\u001b[0m"]
[127517.584741, "o", "\r\n"]
[127517.584946, "o", "\r\nTASK [Download Gitea Runner binary.] ***************************************************************************************************************************************************\r\n"]
[127517.843961, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[127517.848493, "o", "\r\nTASK [Create gitea runner directory.] **************************************************************************************************************************************************\r\n"]
[127518.029577, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[127518.031239, "o", "\r\nTASK [Check if Gitea Runner is already registered.] ************************************************************************************************************************************\r\n"]
[127518.267976, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[127518.270261, "o", "\r\nTASK [Generate Gitea Runner token.] ****************************************************************************************************************************************************\r\n"]
[127518.280937, "o", "\u001b[0;36mskipping: [localhost]\u001b[0m\r\n"]
[127518.282776, "o", "\r\nTASK [Register Gitea Runner to run on the host OS] *************************************************************************************************************************************\r\n"]
[127518.291398, "o", "\u001b[0;36mskipping: [localhost]\u001b[0m\r\n"]
[127518.293101, "o", "\r\nTASK [Create service file for Gitea Runner] ********************************************************************************************************************************************\r\n"]
[127518.606112, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Start and enable Gitea Runner Service] *******************************************************************************************************************************************\r\n"]
