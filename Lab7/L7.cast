[112714.271063, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\bansible-playbook -i hosts.ini playbook.yml -K"]
[112715.416542, "o", "\r\n\u001b[?2004l\r"]
[112715.666628, "o", "BECOME password: "]
[112719.286739, "o", "\r\n"]
[112719.433725, "o", "\r\nPLAY [Setup Gitea] *********************************************************************************************************************************************************************\r\n"]
[112719.434887, "o", "\r\nTASK [Gathering Facts] *****************************************************************************************************************************************************************\r\n"]
[112720.104505, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[112720.106411, "o", "\r\nTASK [Update apt cache if needed.] *****************************************************************************************************************************************************\r\n"]
[112720.806773, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[112720.808645, "o", "\r\nTASK [Install Gitea dependencies.] *****************************************************************************************************************************************************\r\n"]
[112721.551691, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[112721.555991, "o", "\r\nTASK [Ensure git user exists.] *********************************************************************************************************************************************************\r\n"]
[112721.824928, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[112721.826799, "o", "\r\nTASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[112722.069349, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[112722.200679, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[112722.204011, "o", "\r\n"]
[112722.331554, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[112722.460107, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[112722.461668, "o", "\r\n"]
[112722.594888, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/etc/gitea', 'owner': 'root', 'group': 'git'})\u001b[0m\r\n"]
[112722.59726, "o", "\r\n"]
[112722.59735, "o", "TASK [Ensure app.ini exists.] **********************************************************************************************************************************************************"]
[112722.59744, "o", "\r\n"]
[112722.824928, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m\r\n"]
[112722.959587, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'PATH', 'value': '/var/lib/gitea/data/gitea.db'})\u001b[0m\r\n"]
[112723.084551, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'actions', 'option': 'ENABLED', 'value': 'true'})\u001b[0m"]
[112723.086437, "o", "\r\n"]
[112723.089479, "o", "\r\nTASK [Create service file to start Gitea automatically] ********************************************************************************************************************************\r\n"]
[112723.443969, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Download Gitea binary.] **********************************************************************************************************************************************************\r\n"]
[112723.82777, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[112723.829611, "o", "\r\nTASK [Start and enable Gitea systemd Service.] *****************************************************************************************************************************************\r\n"]
[112724.729114, "o", "\u001b[0;33mchanged: [localhost]\u001b[0m\r\n"]
[112724.735474, "o", "\r\nPLAY RECAP *****************************************************************************************************************************************************************************\r\n\u001b[0;33mlocalhost\u001b[0m                  : \u001b[0;32mok=9   \u001b[0m \u001b[0;33mchanged=1   \u001b[0m unreachable=0    failed=0    skipped=0    rescued=0    ignored=0   \r\n\r\n"]
