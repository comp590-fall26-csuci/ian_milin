[122136.438942, "o", "\u001b[?25l\u001b[95m'\u001b[m\u001b[20;5H      \u001b[1m\u001b[96mnotify\u001b[m\u001b[38;5;224m:\u001b[m restart gitea\u001b[22;5H    - \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Create service file to start Gitea automatically\u001b[23;5H      \u001b[1m\u001b[96mcopy\u001b[m\u001b[38;5;224m:\u001b[m\u001b[24;5H        \u001b[1m\u001b[96mdest\u001b[m\u001b[38;5;224m:\u001b[m /etc/systemd/system/gitea.service\u001b[25;5H        \u001b[1m\u001b[96mcontent\u001b[m\u001b[38;5;224m:\u001b[m |\u001b[26;5H          \u001b[38;5;224m[\u001b[mUnit\u001b[38;5;224m]\u001b[m\u001b[27;5H          Description=Gitea (Git with a cup of tea)\u001b[28;5H          After=syslog.target network.target\u001b[29;5H          \u001b[38;5;224m[\u001b[mService\u001b[38;5;224m]\u001b[m\u001b[30;5H          RestartSec=2s\u001b[31;5H          Type=simple\u001b[32;5H          User=git\u001b[33;5H          Group=git\u001b[34;5H          WorkingDirectory={{ gitea_home \u001b[38;5;224m}\u001b[m}\u001b[35;5H          ExecStart={{ gitea_path }} web -c /etc/gitea/app.ini\u001b[36;5H          Restart=always\u001b[37;5H          Environment=USER=git HOME=/home/git GITEA_WORK_DIR=/var/lib/gitea\u001b[38;5H          \u001b[38;5;224m[\u001b[mInstall\u001b[38;5;224m]\u001b[m\u001b[39;5H          WantedBy=multi-user.target\u001b[40;5H        \u001b[1m\u001b[96mmode\u001b[m\u001b[38;5;224m:\u001b[m \u001b[41;5H      \u001b[1m\u001b[96mnotify\u001b[m\u001b[38;5;224m:\u001b[m reload systemd\u001b[43;5H    \u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Download Gitea binary.\u001b[44;5H      \u001b[1m\u001b[96mget_url\u001b[m\u001b[38;5;224m:\u001b[m\u001b[45;5H        \u001b[1m\u001b[96murl\u001b[m\u001b[38;5;224m:\u001b[m \u001b[46;5H        \u001b[1m\u001b[96mdest\u001b[m\u001b[38;5;224m:\u001b[m \u001b[47;5H        \u001b[1m\u001b[96mmode\u001b[m\u001b[38;5;224m:\u001b[m \u001b[48;5H        \u001b[1m\u001b[96mchecksum\u001b[m\u001b[38;5;224m:\u001b[m \u001b[50;5H    \u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Start and enable Gitea systemd Service.\u001b[51;5H      \u001b[1m\u001b[96msystemd_service\u001b[m\u001b[38;5;224m:\u001b[m\u001b[52;5H        \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m gitea\u001b[53;171H1\u001b[19;75H\u001b[?25h"]
