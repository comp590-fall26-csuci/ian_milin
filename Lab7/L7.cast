[124719.373919, "o", "BECOME password: "]
[124722.835514, "o", "\r\n"]
[124722.982994, "o", "\r\nPLAY [Setup Gitea] *********************************************************************************************************************************************************************"]
[124722.983105, "o", "\r\n"]
[124722.985535, "o", "\r\n"]
[124722.985752, "o", "TASK [Gathering Facts] *****************************************************************************************************************************************************************"]
[124722.985813, "o", "\r\n"]
[124723.643903, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[124723.645618, "o", "\r\nTASK [Update apt cache if needed.] *****************************************************************************************************************************************************\r\n"]
[124727.216775, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[124727.219166, "o", "\r\nTASK [Install Gitea dependencies.] *****************************************************************************************************************************************************\r\n"]
[124727.966776, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Ensure git user exists.] *********************************************************************************************************************************************************\r\n"]
[124728.23388, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[124728.235477, "o", "\r\nTASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[124728.471175, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[124728.472814, "o", "\r\n"]
[124728.605481, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[124728.605638, "o", "\r\n"]
[124728.738144, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[124728.739678, "o", "\r\n"]
[124728.870768, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[124728.999539, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/etc/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[124729.00312, "o", "\r\nTASK [Ensure app.ini exists.] **********************************************************************************************************************************************************\r\n"]
[124729.229749, "o", "\u001b[0;33mchanged: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m\r\n"]
[124729.360126, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'PATH', 'value': '/var/lib/gitea/data/gitea.db'})\u001b[0m"]
[124729.360158, "o", "\r\n"]
[124729.495153, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'actions', 'option': 'ENABLED', 'value': 'true'})\u001b[0m\r\n"]
[124729.619618, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'security', 'option': 'INSTALL_LOCK', 'value': 'true'})\u001b[0m\r\n"]
[124729.62507, "o", "\r\nTASK [Create service file to start Gitea automatically] ********************************************************************************************************************************\r\n"]
[124729.981595, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Download Gitea binary.] **********************************************************************************************************************************************************\r\n"]
[124730.354344, "o", "\u001b[0;32mok: [localhost]\u001b[0m"]
[124730.35754, "o", "\r\n\r\n"]
[124730.357686, "o", "TASK [Start and enable Gitea systemd Service.] *****************************************************************************************************************************************"]
[124730.357753, "o", "\r\n"]
[124730.863179, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[124730.864816, "o", "\r\nTASK [Wait for Gitea to finish starting.] **********************************************************************************************************************************************\r\n"]
[124736.120056, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Download Gitea Runner binary.] ***************************************************************************************************************************************************\r\n"]
[124736.362244, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[124736.363954, "o", "\r\nTASK [Create gitea runner directory.] **************************************************************************************************************************************************\r\n"]
[124736.541635, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[124736.544833, "o", "\r\nTASK [Force pending handlers to run now] ***********************************************************************************************************************************************\r\n"]
[124736.54919, "o", "\r\n"]
[124736.55186, "o", "RUNNING HANDLER [restart gitea] ********************************************************************************************************************************************************\r\n"]
[124736.959797, "o", "\u001b[0;33mchanged: [localhost]\u001b[0m\r\n"]
[124736.961471, "o", "\r\nTASK [Wait for Gitea to come back online after restart] ********************************************************************************************************************************\r\n"]
[124742.228014, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Check if Gitea Runner is already registered.] ************************************************************************************************************************************\r\n"]
[124742.421144, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
