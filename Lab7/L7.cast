[126136.493272, "o", "\r\n\u001b[?2004l\r"]
[126136.714747, "o", "BECOME password: "]
[126140.628058, "o", "\r\n"]
[126140.767094, "o", "\r\nPLAY [Setup Gitea] *********************************************************************************************************************************************************************\r\n"]
[126140.77243, "o", "\r\nTASK [Gathering Facts] *****************************************************************************************************************************************************************\r\n"]
[126141.464785, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[126141.466702, "o", "\r\nTASK [Update apt cache if needed.] *****************************************************************************************************************************************************\r\n"]
[126144.689246, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[126144.691258, "o", "\r\nTASK [Install Gitea dependencies.] *****************************************************************************************************************************************************\r\n"]
[126145.411346, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Ensure git user exists.] *********************************************************************************************************************************************************\r\n"]
[126145.675671, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[126145.903597, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[126146.033417, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[126146.033589, "o", "\r\n"]
[126146.168974, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[126146.169103, "o", "\r\n"]
[126146.29996, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n\r\nTASK [Ensure app.ini exists.] **********************************************************************************************************************************************************\r\n"]
[126146.525229, "o", "\u001b[0;33mchanged: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m"]
[126146.526719, "o", "\r\n"]
[126146.656001, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'PATH', 'value': '/var/lib/gitea/data/gitea.db'})\u001b[0m\r\n"]
[126146.787363, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'actions', 'option': 'ENABLED', 'value': 'true'})\u001b[0m\r\n"]
[126146.789907, "o", "\r\nTASK [Create service file to start Gitea automatically] ********************************************************************************************************************************\r\n"]
[126147.142821, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Download Gitea binary.] **********************************************************************************************************************************************************\r\n"]
[126147.520306, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[126147.521704, "o", "\r\nTASK [Start and enable Gitea systemd Service.] *****************************************************************************************************************************************\r\n"]
[126148.074024, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Wait for Gitea to finish starting.] **********************************************************************************************************************************************\r\n"]
[126153.396119, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[126153.396896, "o", "\r\nTASK [Download Gitea Runner binary.] ***************************************************************************************************************************************************\r\n"]
[126153.650507, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Create gitea runner directory.] **************************************************************************************************************************************************\r\n"]
[126153.828018, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[126153.828698, "o", "\r\nTASK [Check if Gitea Runner is already registered.] ************************************************************************************************************************************\r\n"]
[126153.999311, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[126154.003251, "o", "\r\nTASK [Generate Gitea Runner token.] ****************************************************************************************************************************************************\r\n"]
[126154.288036, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
