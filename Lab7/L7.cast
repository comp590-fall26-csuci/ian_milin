[124850.590056, "o", "\u001b[K\u001b[41;1H\u001b[93m 76\u001b[m\u001b[7C    Group=git\u001b[41;24H\u001b[K\u001b[42;1H\u001b[93m 77\u001b[m\u001b[11CWorkingDirectory={{ gitea_home }}\r\n\u001b[93m 78\u001b[m\u001b[5C      ExecStart={{ gitea_path }} web -c /etc/gitea/app.ini\r\n\u001b[93m 79\u001b[m\u001b[7C    Restart=always\r\n\u001b[93m 80\u001b[m\u001b[9C  Environment=USER=git HOME=/home/git GITEA_WORK_DIR=/var/lib/gitea\r\n\u001b[93m 81\u001b[m\u001b[9C  [Install]\r\n\u001b[93m 82\u001b[m\u001b[9C  WantedBy=multi-user.target\r\n\u001b[93m 83\u001b[m\u001b[15C\u001b[95m0644\u001b[m\u001b[48;23H\u001b[K\u001b[49;1H\u001b[93m 84\u001b[m\u001b[7C\u001b[1m\u001b[96mnotify\u001b[m\u001b[38;5;224m:\u001b[m reload systemd\r\n\u001b[93m 85\u001b[m\u001b[50;13H\u001b[K\u001b[51;1H\u001b[93m 86\u001b[m\u001b[5C\u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Download Gitea binary.\u001b[51;39H\u001b[K\u001b[52;1H\u001b[93m 87\u001b[m\u001b[7C\u001b[1m\u001b[96mget_url\u001b[m\u001b[38;5;224m:\u001b[m\u001b[53;167H61,23\u001b[9C29%\u001b[53;167H\u001b[K\u001b[53;167H61,23\u001b[9C29%\u001b[26;27H\u001b[?25h"]
