[121598.460037, "o", "\r\n"]
[121598.591822, "o", "\r\nPLAY [Setup Gitea] *********************************************************************************************************************************************************************\r\n"]
[121598.59622, "o", "\r\nTASK [Gathering Facts] *****************************************************************************************************************************************************************\r\n"]
[121599.227718, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[121599.232026, "o", "\r\nTASK [Update apt cache if needed.] *****************************************************************************************************************************************************\r\n"]
[121600.006368, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[121600.012385, "o", "\r\nTASK [Install Gitea dependencies.] *****************************************************************************************************************************************************\r\n"]
[121600.750918, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[121600.756062, "o", "\r\nTASK [Ensure git user exists.] *********************************************************************************************************************************************************\r\n"]
[121601.028079, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[121601.260091, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[121601.389421, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[121601.520116, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[121601.649227, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[121601.780199, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/etc/gitea', 'owner': 'root', 'group': 'git'})\u001b[0m\r\n"]
[121601.781316, "o", "\r\nTASK [Ensure app.ini exists.] **********************************************************************************************************************************************************\r\n"]
[121602.007166, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m\r\n"]
[121602.140028, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'PATH', 'value': '/var/lib/gitea/data/gitea.db'})\u001b[0m\r\n"]
[121602.266774, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'actions', 'option': 'ENABLED', 'value': 'true'})\u001b[0m\r\n"]
[121602.26931, "o", "\r\n"]
