[127123.619755, "o", "\u001b[?25l\u001b[1;52r\u001b[m\u001b[1;1H\u001b[6M\u001b[1;53r\u001b[47;1H\u001b[93m 90 \r\n 91 \u001b[m    \u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Start and enable Gitea systemd Service.\r\n\u001b[93m 92 \u001b[m      \u001b[1m\u001b[96msystemd_service\u001b[m\u001b[38;5;224m:\u001b[m\r\n\u001b[93m 93 \u001b[m\u001b[8C\u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m gitea\r\n\u001b[93m 94 \u001b[m\u001b[8C\u001b[1m\u001b[96mstate\u001b[m\u001b[38;5;224m:\u001b[m started\r\n\u001b[93m 95 \u001b[m\u001b[8C\u001b[1m\u001b[96menabled\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95mtrue\u001b[m\u001b[53;167H\u001b[K\u001b[53;167H95,22\u001b[9C37%\u001b[46;25H\u001b[95m{\u001b[16C}\u001b[52;26H\u001b[?25h"]
[127123.652746, "o", "\u001b[?25l\u001b[1;52r\u001b[m\u001b[1;1H\u001b[6M\u001b[1;53r\u001b[47;1H\u001b[93m 96 \u001b[m\u001b[8C\u001b[1m\u001b[96mdaemon_reload\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95mtrue\u001b[m\r\n\u001b[93m 97 \r\n 98 \u001b[m    \u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Wait for Gitea to finish starting.\r\n\u001b[93m 99 \u001b[m      \u001b[1m\u001b[96mwait_for\u001b[m\u001b[38;5;224m:\u001b[m\r\n\u001b[93m100 \u001b[m\u001b[8C\u001b[1m\u001b[96mport\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m3000\u001b[m\r\n\u001b[93m101 \u001b[m\u001b[8C\u001b[1m\u001b[96mdelay\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m5\u001b[m\u001b[53;167H\u001b[K\u001b[53;167H101,17\u001b[8C42%\u001b[52;21H\u001b[?25h"]
[127123.669551, "o", "\u001b[?25l\u001b[1;52r\u001b[1;1H\u001b[6M\u001b[1;53r\u001b[47;1H\u001b[93m102 \u001b[m\u001b[8C\u001b[1m\u001b[96mtimeout\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m60\u001b[m\r\n\u001b[93m103 \r\n104 \u001b[m    \u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Download Gitea Runner binary.\r\n\u001b[93m105 \u001b[m      \u001b[1m\u001b[96mget_url\u001b[m\u001b[38;5;224m:\u001b[m\r\n\u001b[93m106 \u001b[m\u001b[8C\u001b[1m\u001b[96murl\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m\"https://dl.gitea.com/gitea-runner/{{ runner_version }}/gitea-runner-{{ runner_version }}-linux-arm64\"\u001b[m\r\n\u001b[93m107 \u001b[m\u001b[8C\u001b[1m\u001b[96mdest\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m\"{{ runner_path }}\"\u001b[m\u001b[53;167H\u001b[K\u001b[53;167H107,22\u001b[8C47%\u001b[52;26H\u001b[?25h"]
[127123.702638, "o", "\u001b[?25l\u001b[1;52r\u001b[1;1H\u001b[6M\u001b[1;53r\u001b[47;1H\u001b[93m108 \u001b[m\u001b[8C\u001b[1m\u001b[96mmode\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m0755\u001b[m\r\n\u001b[93m109 \u001b[m\u001b[8C\u001b[1m\u001b[96mchecksum\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m\"{{ runner_checksum }}\"\u001b[m\r\n\u001b[93m110 \r\n111 \u001b[m    \u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Create gitea runner directory.\r\n\u001b[93m112 \u001b[m      \u001b[1m\u001b[96mfile\u001b[m\u001b[38;5;224m:\u001b[m\r\n\u001b[93m113 \u001b[m\u001b[8C\u001b[1m\u001b[96mpath\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m\"{{ runner_home }}\"\u001b[m\u001b[53;167H\u001b[K\u001b[53;167H113,22\u001b[8C53%\u001b[52;26H\u001b[?25h"]
[127123.736116, "o", "\u001b[?25l\u001b[1;52r\u001b[1;1H\u001b[6M\u001b[1;53r\u001b[47;1H\u001b[93m114 \u001b[m\u001b[8C\u001b[1m\u001b[96mstate\u001b[m\u001b[38;5;224m:\u001b[m directory\r\n\u001b[93m115 \u001b[m\u001b[8C\u001b[1m\u001b[96mowner\u001b[m\u001b[38;5;224m:\u001b[m root\r\n\u001b[93m116 \u001b[m\u001b[8C\u001b[1m\u001b[96mgroup\u001b[m\u001b[38;5;224m:\u001b[m root\r\n\u001b[93m117 \u001b[m\u001b[8C\u001b[1m\u001b[96mmode\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m0755\u001b[m\r\n\u001b[93m118 \r\n119 \u001b[m    \u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Check if Gitea Runner is already registered.\u001b[53;167H\u001b[K\u001b[53;167H119,22\u001b[8C58%\u001b[52;26H\u001b[?25h"]
[127123.769214, "o", "\u001b[?25l\u001b[1;52r\u001b[1;1H\u001b[6M\u001b[1;53r\u001b[47;1H\u001b[93m120 \u001b[m      \u001b[1m\u001b[96mstat\u001b[m\u001b[38;5;224m:\u001b[m\r\n\u001b[93m121 \u001b[m\u001b[8C\u001b[1m\u001b[96mpath\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m\"{{ runner_home }}/.runner\"\u001b[m\r\n\u001b[93m122 \u001b[m      \u001b[1m\u001b[96mregister\u001b[m\u001b[38;5;224m:\u001b[m runner_reg\r\n\u001b[93m123 \r\n124 \u001b[m    \u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Generate Gitea Runner token.\r\n\u001b[93m125 \u001b[m      \u001b[1m\u001b[96mcommand\u001b[m\u001b[38;5;224m:\u001b[m \u001b[38;5;224m>\u001b[m\u001b[53;167H\u001b[K\u001b[53;167H125,17\u001b[8C63%\u001b[52;21H\u001b[?25h"]
[127123.819948, "o", "\u001b[?25l\u001b[1;52r\u001b[1;1H\u001b[6M\u001b[1;53r\u001b[47;1H\u001b[93m126 \u001b[m\u001b[8Csudo -u git GITEA_WORK_DIR={{ gitea_home }} {{ gitea_path }} --config /etc/gitea/app.ini actions generate-runner-token\r\n\u001b[93m127 \u001b[m      \u001b[1m\u001b[96mregister\u001b[m\u001b[38;5;224m:\u001b[m runner_token_output\r\n\u001b[93m128 \u001b[m      \u001b[1m\u001b[96mchanged_when\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95mfalse\u001b[m\r\n\u001b[93m129 \u001b[m      \u001b[1m\u001b[96mwhen\u001b[m\u001b[38;5;224m:\u001b[m not runner_reg.stat.exists\r\n\u001b[93m130 \r\n131 \u001b[m    \u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Register Gitea Runner to run on the host OS\u001b[53;167H\u001b[K\u001b[53;167H131,22\u001b[8C68%\u001b[52;26H\u001b[?25h"]
[127123.869104, "o", "\u001b[?25l\u001b[1;52r\u001b[1;1H\u001b[6M\u001b[1;53r\u001b[47;1H\u001b[93m132 \u001b[m      \u001b[1m\u001b[96mcommand\u001b[m\u001b[38;5;224m:\u001b[m \u001b[38;5;224m>\u001b[m\r\n\u001b[93m133 \u001b[m\u001b[8Cgitea-runner register\r\n\u001b[93m134 \u001b[m\u001b[8C--no-interactive\r\n\u001b[93m135 \u001b[m\u001b[8C--instance http://127.0.0.1:3000\r\n\u001b[93m136 \u001b[m\u001b[8C--token {{ runner_token_output.stdout }}\r\n\u001b[93m137 \u001b[m\u001b[8C--labels \"ubuntu-latest:host,debian-latest:host,local:host\"\u001b[53;167H\u001b[K\u001b[53;167H137,22\u001b[8C73%\u001b[52;26H\u001b[?25h"]
[127123.919834, "o", "\u001b[?25l\u001b[1;52r\u001b[1;1H\u001b[6M\u001b[1;53r\u001b[47;1H\u001b[93m138 \u001b[m      \u001b[1m\u001b[96margs\u001b[m\u001b[38;5;224m:\u001b[m\r\n\u001b[93m139 \u001b[m\u001b[8C\u001b[1m\u001b[96mchdir\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m\"{{ runner_home }}\"\u001b[m\r\n\u001b[93m140 \u001b[m      \u001b[1m\u001b[96mwhen\u001b[m\u001b[38;5;224m:\u001b[m not runner_reg.stat.exists\r\n\u001b[93m141 \r\n142 \u001b[m    \u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Create service file for Gitea Runner\r\n\u001b[93m143 \u001b[m      \u001b[1m\u001b[96mcopy\u001b[m\u001b[38;5;224m:\u001b[m\u001b[53;167H\u001b[K\u001b[53;167H143,12\u001b[8C79%\u001b[52;16H\u001b[?25h"]
[127124.004171, "o", "\u001b[?25l\u001b[1;52r\u001b[1;1H\u001b[6M\u001b[1;53r\u001b[47;1H\u001b[93m144 \u001b[m\u001b[8C\u001b[1m\u001b[96mdest\u001b[m\u001b[38;5;224m:\u001b[m /etc/systemd/system/gitea-runner.service\r\n\u001b[93m145 \u001b[m\u001b[8C\u001b[1m\u001b[96mcontent\u001b[m\u001b[38;5;224m:\u001b[m \u001b[38;5;224m|\u001b[m\r\n\u001b[93m146 \u001b[m\u001b[10C[Unit]\r\n\u001b[93m147 \u001b[m\u001b[10CDescription=Gitea Actions runner\r\n\u001b[93m148 \u001b[m\u001b[10CAfter=gitea.service\r\n\u001b[93m149 \u001b[m\u001b[10C[Service]\u001b[53;167H\u001b[K\u001b[53;167H149,20\u001b[8C84%\u001b[52;15H\u001b[46m[\u001b[7C]\u001b[?25h"]
[127124.104774, "o", "\u001b[?25l\u001b[1;52r\u001b[m\u001b[1;1H\u001b[6M\u001b[1;53r\u001b[47;1H\u001b[93m150 \u001b[m\u001b[10CExecStart={{ runner_path }} daemon\r\n\u001b[93m151 \u001b[m\u001b[10CWorkingDirectory={{ runner_home }}\r\n\u001b[93m152 \u001b[m\u001b[10CRestart=always\r\n\u001b[93m153 \u001b[m\u001b[10CRestartSec=5s\r\n\u001b[93m154 \u001b[m\u001b[10C[Install]\r\n\u001b[93m155 \u001b[m\u001b[10CWantedBy=multi-user.target\u001b[53;167H\u001b[K\u001b[53;167H155,22\u001b[8C89%\u001b[46;15H[\u001b[7C]\u001b[52;26H\u001b[?25h"]
[127124.294434, "o", "\u001b[?25l\u001b[1;52r\u001b[1;1H\u001b[6M\u001b[1;53r\u001b[47;1H\u001b[93m156 \u001b[m\u001b[8C\u001b[1m\u001b[96mmode\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m0644\u001b[m\r\n\u001b[93m157 \u001b[m      \u001b[1m\u001b[96mnotify\u001b[m\u001b[38;5;224m:\u001b[m reload systemd\r\n\u001b[93m158 \r\n159 \u001b[m  \u001b[1m\u001b[96mhandlers\u001b[m\u001b[38;5;224m:\u001b[m\r\n\u001b[93m160 \u001b[m    \u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m restart gitea\r\n\u001b[93m161 \u001b[m      \u001b[1m\u001b[96msystemd\u001b[m\u001b[38;5;224m:\u001b[m\u001b[53;167H\u001b[K\u001b[53;167H161,15\u001b[8C94%\u001b[52;19H\u001b[?25h"]
[127124.338206, "o", "\u001b[?25l\u001b[1;52r\u001b[1;1H\u001b[6M\u001b[1;53r\u001b[47;1H\u001b[93m162 \u001b[m\u001b[8C\u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m gitea\r\n\u001b[93m163 \u001b[m\u001b[8C\u001b[1m\u001b[96mstate\u001b[m\u001b[38;5;224m:\u001b[m restarted\r\n\u001b[93m164 \r\n165 \u001b[m    \u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m reload systemd\r\n\u001b[93m166 \u001b[m      \u001b[1m\u001b[96msystemd\u001b[m\u001b[38;5;224m:\u001b[m\r\n\u001b[93m167 \u001b[m\u001b[8C\u001b[1m\u001b[96mdaemon_reload\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95mtrue\u001b[m\u001b[53;167H\u001b[K\u001b[53;167H167,22\u001b[8CBot\u001b[52;26H\u001b[?25h"]
