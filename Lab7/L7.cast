[120970.649201, "o", "\u001b[?25l\u001b[1;52r\u001b[1;1H\u001b[6M\u001b[1;53r\u001b[47;1H\u001b[93m127 \u001b[m\u001b[8Csudo -u git GITEA_WORK_DIR={{ gitea_home }} {{ gitea_path }}\r\n\u001b[93m128 \u001b[m\u001b[8C--config /etc/gitea/app.ini actions generate-runner-token\r\n\u001b[93m129 \u001b[m      \u001b[1m\u001b[96mregister\u001b[m\u001b[38;5;224m:\u001b[m runner_token_output\r\n\u001b[93m130 \u001b[m      \u001b[1m\u001b[96mchanged_when\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95mfalse\u001b[m\r\n\u001b[93m131 \u001b[m      \u001b[1m\u001b[96mwhen\u001b[m\u001b[38;5;224m:\u001b[m not runner_reg.stat.exists\r\n\u001b[93m132 \u001b[m\u001b[53;167H\u001b[K\u001b[53;167H132,1\u001b[9C80%\u001b[52;5H\u001b[?25h"]
[120970.681825, "o", "\u001b[?25l\u001b[1;52r\u001b[1;1H\u001b[6M\u001b[1;53r\u001b[47;1H\u001b[93m133 \u001b[m    \u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Register Gitea Runner to run on the host OS\r\n\u001b[93m134 \u001b[m      \u001b[1m\u001b[96mansible.builtin.command\u001b[m\u001b[38;5;224m:\u001b[m \u001b[38;5;224m>\u001b[m\r\n\u001b[93m135 \u001b[m\u001b[8Cact_runner register\r\n\u001b[93m136 \u001b[m\u001b[8C--no-interactive\r\n\u001b[93m137 \u001b[m\u001b[8C--instance http://127.0.0.1:300\r\n\u001b[93m138 \u001b[m\u001b[8C--token {{ runner_token_output.stdout }}\u001b[53;167H\u001b[K\u001b[53;167H138,34\u001b[8C86%\u001b[52;38H\u001b[?25h"]
