[122865.760805, "o", "vi playbook.yml"]
[122866.015169, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\bansible-playbook -i hosts.ini playbook.yml -K"]
[122866.815962, "o", "\r\n\u001b[?2004l\r"]
[122867.032947, "o", "BECOME password: "]
[122870.693741, "o", "\r\n"]
[122870.838153, "o", "\r\nPLAY [Setup Gitea] *********************************************************************************************************************************************************************\r\n"]
[122870.843276, "o", "\r\nTASK [Gathering Facts] *****************************************************************************************************************************************************************\r\n"]
[122871.4855, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122871.490072, "o", "\r\nTASK [Update apt cache if needed.] *****************************************************************************************************************************************************\r\n"]
[122873.843461, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122873.845222, "o", "\r\nTASK [Install Gitea dependencies.] *****************************************************************************************************************************************************\r\n"]
[122874.568818, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122874.570174, "o", "\r\nTASK [Ensure git user exists.] *********************************************************************************************************************************************************\r\n"]
[122874.828048, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122874.829598, "o", "\r\nTASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[122875.060174, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[122875.187792, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[122875.315967, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[122875.444068, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[122875.576474, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/etc/gitea', 'owner': 'root', 'group': 'git'})\u001b[0m\r\n"]
[122875.578827, "o", "\r\n"]
[122875.581184, "o", "TASK [Ensure app.ini exists.] **********************************************************************************************************************************************************\r\n"]
[122875.809428, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m\r\n"]
[122875.936826, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'PATH', 'value': '/var/lib/gitea/data/gitea.db'})\u001b[0m\r\n"]
[122876.06421, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'actions', 'option': 'ENABLED', 'value': 'true'})\u001b[0m\r\n"]
[122876.193139, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'security', 'option': 'INSTALL_LOCK', 'value': 'true'})\u001b[0m"]
[122876.194928, "o", "\r\n"]
[122876.197853, "o", "\r\nTASK [Create service file to start Gitea automatically] ********************************************************************************************************************************\r\n"]
[122876.55035, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122876.552732, "o", "\r\nTASK [Download Gitea binary.] **********************************************************************************************************************************************************\r\n"]
[122876.911626, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122876.913243, "o", "\r\nTASK [Start and enable Gitea systemd Service.] *****************************************************************************************************************************************\r\n"]
[122877.438768, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122877.443149, "o", "\r\nTASK [Wait for Gitea to finish starting.] **********************************************************************************************************************************************\r\n"]
[122882.704381, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122882.708118, "o", "\r\nTASK [Download Gitea Runner binary.] ***************************************************************************************************************************************************\r\n"]
[122882.951243, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122882.955498, "o", "\r\nTASK [Create gitea runner directory.] **************************************************************************************************************************************************"]
[122882.955622, "o", "\r\n"]
[122883.135002, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[122883.136434, "o", "\r\nTASK [Check if Gitea Runner is already registered.] ************************************************************************************************************************************\r\n"]
