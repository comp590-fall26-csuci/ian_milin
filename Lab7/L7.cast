[112033.805331, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\bansible-playbook -i hosts.ini playbook.yml -K"]
[112034.383661, "o", "\r\n\u001b[?2004l\r"]
[112034.627007, "o", "BECOME password: "]
[112038.016458, "o", "\r\n"]
[112038.165634, "o", "\r\nPLAY [Setup Gitea] *********************************************************************************************************************************************************************\r\n"]
[112038.170665, "o", "\r\n"]
[112038.170785, "o", "TASK [Gathering Facts] *****************************************************************************************************************************************************************\r\n"]
[112038.856883, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[112038.860017, "o", "\r\nTASK [Update apt cache if needed.] *****************************************************************************************************************************************************\r\n"]
[112039.56005, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[112039.563825, "o", "\r\nTASK [Install Gitea dependencies.] *****************************************************************************************************************************************************\r\n"]
[112040.29967, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Ensure git user exists.] *********************************************************************************************************************************************************\r\n"]
[112040.594694, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[112040.596438, "o", "\r\nTASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[112040.905353, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[112040.905478, "o", "\r\n"]
[112041.038644, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[112041.171156, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[112041.300257, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[112041.301862, "o", "\r\n"]
[112041.437323, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/etc/gitea', 'owner': 'root', 'group': 'git'})\u001b[0m\r\n"]
[112041.439489, "o", "\r\n"]
[112041.439581, "o", "TASK [Ensure app.ini exists.] **********************************************************************************************************************************************************"]
[112041.43963, "o", "\r\n"]
[112041.667945, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m\r\n"]
[112041.796332, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'PATH', 'value': '/var/lib/gitea/data/gitea.db'})\u001b[0m\r\n"]
[112041.921807, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'actions', 'option': 'ENABLED', 'value': 'true'})\u001b[0m\r\n"]
[112041.929048, "o", "\r\nTASK [Create service file to start Gitea automatically] ********************************************************************************************************************************"]
[112041.929157, "o", "\r\n"]
[112042.325626, "o", "\u001b[0;33mchanged: [localhost]\u001b[0m\r\n"]
[112042.327185, "o", "\r\n"]
[112042.327209, "o", "TASK [Download Gitea binary.] **********************************************************************************************************************************************************\r\n"]
[112042.689229, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[112042.691979, "o", "\r\nPLAY RECAP *****************************************************************************************************************************************************************************\r\n\u001b[0;33mlocalhost\u001b[0m                  : \u001b[0;32mok=8   \u001b[0m \u001b[0;33mchanged=1   \u001b[0m unreachable=0    failed=0    skipped=0    rescued=0    ignored=0   \r\n\r\n"]
