[127022.141085, "o", "\u001b[?2004h"]
[127022.141626, "o", "(.venv) \u001b]0;parallels@debian-13-6: ~/COMP590Fall2026/LABS/ian_milin/Lab7\u0007\u001b[01;32mparallels@debian-13-6\u001b[00m:\u001b[01;34m~/COMP590Fall2026/LABS/ian_milin/Lab7\u001b[00m$ "]
[127023.185975, "o", "vi playbook.yml"]
[127023.528911, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\bansible-playbook -i hosts.ini playbook.yml -K"]
[127024.677981, "o", "\r\n"]
[127024.67814, "o", "\u001b[?2004l\r"]
[127024.900971, "o", "BECOME password: "]
[127027.95866, "o", "\r\n"]
[127028.106108, "o", "\r\nPLAY [Setup Gitea] *********************************************************************************************************************************************************************"]
[127028.10628, "o", "\r\n"]
[127028.107499, "o", "\r\n"]
[127028.107534, "o", "TASK [Gathering Facts] *****************************************************************************************************************************************************************"]
[127028.107567, "o", "\r\n"]
[127028.801378, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[127028.803249, "o", "\r\nTASK [Update apt cache if needed.] *****************************************************************************************************************************************************\r\n"]
[127031.97998, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[127031.991139, "o", "\r\nTASK [Install Gitea dependencies.] *****************************************************************************************************************************************************\r\n"]
[127032.737088, "o", "\u001b[0;32mok: [localhost]\u001b[0m"]
[127032.737243, "o", "\r\n"]
[127032.74122, "o", "\r\n"]
[127032.741361, "o", "TASK [Ensure git user exists.] *********************************************************************************************************************************************************"]
[127032.741445, "o", "\r\n"]
[127033.011282, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[127033.241324, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[127033.370701, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m"]
[127033.370839, "o", "\r\n"]
[127033.50562, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[127033.633374, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[127033.637037, "o", "\r\n"]
[127033.63723, "o", "TASK [Ensure app.ini exists.] **********************************************************************************************************************************************************"]
[127033.637299, "o", "\r\n"]
[127033.865485, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m\r\n"]
[127033.997204, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'PATH', 'value': '/var/lib/gitea/data/gitea.db'})\u001b[0m\r\n"]
[127034.123497, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'actions', 'option': 'ENABLED', 'value': 'true'})\u001b[0m\r\n\r\n"]
[127034.125855, "o", "TASK [Create service file to start Gitea automatically] ********************************************************************************************************************************\r\n"]
[127034.484797, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[127034.486236, "o", "\r\nTASK [Download Gitea binary.] **********************************************************************************************************************************************************\r\n"]
[127034.86205, "o", "\u001b[0;32mok: [localhost]\u001b[0m"]
[127034.865154, "o", "\r\n\r\n"]
[127034.865213, "o", "TASK [Start and enable Gitea systemd Service.] *****************************************************************************************************************************************"]
[127034.865254, "o", "\r\n"]
[127035.386517, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[127035.388222, "o", "\r\nTASK [Wait for Gitea to finish starting.] **********************************************************************************************************************************************\r\n"]
[127040.65181, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[127040.659016, "o", "\r\nTASK [Download Gitea Runner binary.] ***************************************************************************************************************************************************\r\n"]
[127040.896021, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[127040.898795, "o", "\r\nTASK [Create gitea runner directory.] **************************************************************************************************************************************************\r\n"]
[127041.078927, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Check if Gitea Runner is already registered.] ************************************************************************************************************************************\r\n"]
[127041.258836, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[127041.260707, "o", "\r\nTASK [Generate Gitea Runner token.] ****************************************************************************************************************************************************\r\n"]
[127041.274411, "o", "\u001b[0;36mskipping: [localhost]\u001b[0m\r\n\r\nTASK [Register Gitea Runner to run on the host OS] *************************************************************************************************************************************\r\n"]
[127041.28265, "o", "\u001b[0;36mskipping: [localhost]\u001b[0m\r\n"]
