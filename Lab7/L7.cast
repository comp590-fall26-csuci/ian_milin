[119244.813528, "o", "(.venv) \u001b]0;parallels@debian-13-6: ~/COMP590Fall2026/LABS/ian_milin/Lab7\u0007\u001b[01;32mparallels@debian-13-6\u001b[00m:\u001b[01;34m~/COMP590Fall2026/LABS/ian_milin/Lab7\u001b[00m$ "]
[119245.464596, "o", "vi playbook.yml"]
[119245.754845, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\bansible-playbook -i hosts.ini playbook.yml -K"]
[119246.782573, "o", "\r\n"]
[119246.783249, "o", "\u001b[?2004l\r"]
[119247.025186, "o", "BECOME password: "]
[119250.723011, "o", "\r\n"]
[119250.86701, "o", "\r\nPLAY [Setup Gitea] *********************************************************************************************************************************************************************\r\n"]
[119250.871579, "o", "\r\nTASK [Gathering Facts] *****************************************************************************************************************************************************************\r\n"]
[119252.464297, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[119252.46615, "o", "\r\n"]
[119252.468006, "o", "TASK [Update apt cache if needed.] *****************************************************************************************************************************************************\r\n"]
[119255.986396, "o", "\u001b[0;33mchanged: [localhost]\u001b[0m\r\n\r\nTASK [Install Gitea dependencies.] *****************************************************************************************************************************************************\r\n"]
[119256.739697, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[119256.74353, "o", "\r\nTASK [Ensure git user exists.] *********************************************************************************************************************************************************\r\n"]
[119257.006484, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[119257.007901, "o", "\r\nTASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[119257.254253, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[119257.385284, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[119257.515419, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[119257.658982, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[119257.787709, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/etc/gitea', 'owner': 'root', 'group': 'git'})\u001b[0m"]
[119257.787742, "o", "\r\n"]
[119257.791682, "o", "\r\n"]
[119257.791838, "o", "TASK [Ensure app.ini exists.] **********************************************************************************************************************************************************"]
[119257.791955, "o", "\r\n"]
[119258.022484, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m\r\n"]
[119258.148445, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'PATH', 'value': '/var/lib/gitea/data/gitea.db'})\u001b[0m\r\n"]
[119258.280661, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'actions', 'option': 'ENABLED', 'value': 'true'})\u001b[0m\r\n"]
[119258.280701, "o", "\r\nTASK [Create service file to start Gitea automatically] ********************************************************************************************************************************\r\n"]
[119258.643556, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[119258.645108, "o", "\r\nTASK [Download Gitea binary.] **********************************************************************************************************************************************************\r\n"]
[119259.028769, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[119259.02881, "o", "\r\nTASK [Start and enable Gitea systemd Service.] *****************************************************************************************************************************************\r\n"]
[119259.55606, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[119259.55638, "o", "\r\nTASK [Wait for Gitea to finish starting.] **********************************************************************************************************************************************\r\n"]
[119264.884254, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[119264.888072, "o", "\r\nTASK [Download Gitea Runner binary.] ***************************************************************************************************************************************************\r\n"]
[119265.803938, "o", "\u001b[0;33mchanged: [localhost]\u001b[0m\r\n"]
[119265.803979, "o", "\r\nPLAY RECAP *****************************************************************************************************************************************************************************\r\n\u001b[0;33mlocalhost\u001b[0m                  : \u001b[0;32mok=11  \u001b[0m \u001b[0;33mchanged=2   \u001b[0m unreachable=0    failed=0    skipped=0    rescued=0    ignored=0   \r\n\r\n"]
