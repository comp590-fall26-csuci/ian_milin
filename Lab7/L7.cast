[121155.648935, "o", "\r\n"]
[121155.7888, "o", "\r\nPLAY [Setup Gitea] *********************************************************************************************************************************************************************\r\n"]
[121155.793516, "o", "\r\nTASK [Gathering Facts] *****************************************************************************************************************************************************************\r\n"]
[121156.440846, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[121156.444056, "o", "\r\nTASK [Update apt cache if needed.] *****************************************************************************************************************************************************\r\n"]
[121157.135975, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Install Gitea dependencies.] *****************************************************************************************************************************************************\r\n"]
[121157.855613, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[121157.85985, "o", "\r\nTASK [Ensure git user exists.] *********************************************************************************************************************************************************\r\n"]
[121158.126173, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[121158.127611, "o", "\r\nTASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[121158.357627, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[121158.490782, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[121158.620273, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[121158.752491, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[121158.887967, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/etc/gitea', 'owner': 'root', 'group': 'git'})\u001b[0m\r\n\r\nTASK [Ensure app.ini exists.] **********************************************************************************************************************************************************\r\n"]
[121159.109884, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m\r\n"]
[121159.241694, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'PATH', 'value': '/var/lib/gitea/data/gitea.db'})\u001b[0m\r\n"]
[121159.367016, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'actions', 'option': 'ENABLED', 'value': 'true'})\u001b[0m\r\n"]
[121159.36972, "o", "\r\nTASK [Create service file to start Gitea automatically] ********************************************************************************************************************************\r\n"]
[121159.723009, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[121159.727883, "o", "\r\nTASK [Download Gitea binary.] **********************************************************************************************************************************************************\r\n"]
[121160.096534, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[121160.099999, "o", "\r\nTASK [Start and enable Gitea systemd Service.] *****************************************************************************************************************************************\r\n"]
[121160.638167, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\n"]
[121160.63983, "o", "TASK [Wait for Gitea to finish starting.] **********************************************************************************************************************************************"]
[121160.63985, "o", "\r\n"]
[121165.907994, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Download Gitea Runner binary.] ***************************************************************************************************************************************************\r\n"]
