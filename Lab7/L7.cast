[111313.129002, "o", "\u001b[m\u001b[8C\u001b[36mmode\u001b[m\u001b[35m:\u001b[m \u001b[31m0750\u001b[m\r\n\u001b[38;5;130m 36 \u001b[m      \u001b[36mloop\u001b[m\u001b[35m:\u001b[m\r\n\u001b[38;5;130m 37 \u001b[8C-\u001b[m \u001b[35m{\u001b[m \u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m'/var/lib/gitea'\u001b[m, \u001b[36mowner\u001b[m\u001b[35m:\u001b[m \u001b[31m'git'\u001b[m, \u001b[36mgroup\u001b[m\u001b[35m:\u001b[m \u001b[31m'git'\u001b[m \u001b[35m}\u001b[m\r\n\u001b[38;5;130m 38 \u001b[8C-\u001b[m \u001b[35m{\u001b[m \u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m'/var/lib/gitea/custom'\u001b[m, \u001b[36mowner\u001b[m\u001b[35m:\u001b[m \u001b[31m'git'\u001b[m, \u001b[36mgroup\u001b[m\u001b[35m:\u001b[m \u001b[31m'git'\u001b[m \u001b[35m}\u001b[m\r\n\u001b[38;5;130m 39 \u001b[8C-\u001b[m \u001b[35m{\u001b[m \u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m'/var/lib/gitea/data'\u001b[m, \u001b[36mowner\u001b[m\u001b[35m:\u001b[m \u001b[31m'git'\u001b[m, \u001b[36mgroup\u001b[m\u001b[35m:\u001b[m \u001b[31m'git'\u001b[m \u001b[35m}\u001b[m\r\n\u001b[38;5;130m 40 \u001b[8C-\u001b[m \u001b[35m{\u001b[m \u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m'/var/lib/gitea/log'\u001b[m, \u001b[36mowner\u001b[m\u001b[35m:\u001b[m \u001b[31m'git'\u001b[m, \u001b[36mgroup\u001b[m\u001b[35m:\u001b[m \u001b[31m'git'\u001b[m \u001b[35m}\u001b[m\r\n\u001b[38;5;130m 41 \u001b[8C-\u001b[m \u001b[35m{\u001b[m \u001b[36mpath\u001b[m\u001b[35m:\u001b[m \u001b[31m'/etc/gitea'\u001b[m, \u001b[36mowner\u001b[m\u001b[35m:\u001b[m \u001b[31m'root'\u001b[m, \u001b[36mgroup\u001b[m\u001b[35m:\u001b[m \u001b[31m'git'\u001b[m \u001b[35m}\u001b[m\r\n\u001b[38;5;130m 42 \r\n 43 \u001b[m    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Ensure app.ini exists.\r\n\u001b[38;5;130m 44 \u001b[m      \u001b[36mini_file\u001b[m\u001b[35m:\u001b[m\r\n\u001b[38;5;130m 45 \u001b[m\u001b[8C\u001b[36mpath\u001b[m\u001b[35m:\u001b[m /etc/gitea/app.ini\r\n\u001b[3