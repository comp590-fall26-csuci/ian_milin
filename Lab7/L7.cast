[125450.80994, "o", "\r\n\u001b[?2004l\r"]
[125451.030616, "o", "BECOME password: "]
[125455.116097, "o", "\r\n"]
[125455.247975, "o", "\r\nPLAY [Setup Gitea] *********************************************************************************************************************************************************************\r\n"]
[125455.249253, "o", "\r\nTASK [Gathering Facts] *****************************************************************************************************************************************************************\r\n"]
[125455.935967, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[125455.94001, "o", "\r\nTASK [Update apt cache if needed.] *****************************************************************************************************************************************************\r\n"]
[125458.634009, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[125458.640923, "o", "\r\nTASK [Install Gitea dependencies.] *****************************************************************************************************************************************************\r\n"]
[125459.420061, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[125459.422613, "o", "\r\nTASK [Ensure git user exists.] *********************************************************************************************************************************************************\r\n"]
[125459.690832, "o", "\u001b[0;32mok: [localhost]\u001b[0m"]
[125459.69086, "o", "\r\n"]
[125459.692268, "o", "\r\nTASK [Ensure required directory structure exists.] *************************************************************************************************************************************\r\n"]
[125459.928269, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[125460.063415, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/custom', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[125460.192628, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/data', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[125460.322224, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/var/lib/gitea/log', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[125460.453318, "o", "\u001b[0;32mok: [localhost] => (item={'path': '/etc/gitea', 'owner': 'git', 'group': 'git'})\u001b[0m\r\n"]
[125460.453356, "o", "\r\nTASK [Ensure app.ini exists.] **********************************************************************************************************************************************************\r\n"]
[125460.682567, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'DB_TYPE', 'value': 'sqlite3'})\u001b[0m"]
[125460.683796, "o", "\r\n"]
[125460.814482, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'database', 'option': 'PATH', 'value': '/var/lib/gitea/data/gitea.db'})\u001b[0m\r\n"]
[125460.943461, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'actions', 'option': 'ENABLED', 'value': 'true'})\u001b[0m"]
[125460.947406, "o", "\r\n"]
[125461.074221, "o", "\u001b[0;32mok: [localhost] => (item={'section': 'security', 'option': 'INSTALL_LOCK', 'value': 'true'})\u001b[0m\r\n"]
[125461.077225, "o", "\r\nTASK [Create service file to start Gitea automatically] ********************************************************************************************************************************\r\n"]
[125461.431974, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[125461.436033, "o", "\r\nTASK [Download Gitea binary.] **********************************************************************************************************************************************************\r\n"]
[125461.799001, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[125461.803025, "o", "\r\nTASK [Start and enable Gitea systemd Service.] *****************************************************************************************************************************************\r\n"]
[125462.344275, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[125462.348492, "o", "\r\nTASK [Wait for Gitea to finish starting.] **********************************************************************************************************************************************\r\n"]
[125467.603408, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Download Gitea Runner binary.] ***************************************************************************************************************************************************\r\n"]
[125467.84387, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[125467.848063, "o", "\r\nTASK [Create gitea runner directory.] **************************************************************************************************************************************************\r\n"]
[125468.025914, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[125468.027445, "o", "\r\nTASK [Force pending handlers to run now] ***********************************************************************************************************************************************\r\n"]
[125468.029744, "o", "\r\nTASK [Wait for Gitea to come back online after restart] ********************************************************************************************************************************\r\n"]
[125473.23981, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n\r\nTASK [Check if Gitea Runner is already registered.] ************************************************************************************************************************************\r\n"]
[125473.429238, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[125473.431992, "o", "\r\nTASK [Generate Gitea Runner token.] ****************************************************************************************************************************************************\r\n"]
[125473.723869, "o", "\u001b[0;32mok: [localhost]\u001b[0m\r\n"]
[125473.725569, "o", "\r\nTASK [Register Gitea Runner to run on the host OS] *************************************************************************************************************************************\r\n"]
[125473.918236, "o", "\u001b[0;33mchanged: [localhost]\u001b[0m\r\n"]
[125473.919944, "o", "\r\nTASK [Set permissions to read-only after installation.] ********************************************************************************************************************************\r\n"]
[125474.097691, "o", "\u001b[0;33mchanged: [localhost] => (item={'path': '/etc/gitea', 'mode': '0750'})\u001b[0m"]
[125474.097831, "o", "\r\n"]
[125474.234188, "o", "\u001b[0;33mchanged: [localhost] => (item={'path': '/etc/gitea/app.ini', 'mode': '0640'})\u001b[0m\r\n"]
[125474.235954, "o", "\r\nPLAY RECAP *****************************************************************************************************************************************************************************\r\n\u001b[0;33mlocalhost\u001b[0m                  : \u001b[0;32mok=17  \u001b[0m \u001b[0;33mchanged=2   \u001b[0m unreachable=0    failed=0    skipped=0    rescued=0    ignored=0   \r\n\r\n"]
