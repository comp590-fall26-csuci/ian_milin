[125347.44329, "o", "\u001b[?25l\u001b[1;52r\u001b[1;1H\u001b[6M\u001b[1;53r\u001b[47;1H\u001b[93m134 \r\n135 \u001b[m    \u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Generate Gitea Runner token.\r\n\u001b[93m136 \u001b[m      \u001b[1m\u001b[96mcommand\u001b[m\u001b[38;5;224m:\u001b[m \u001b[38;5;224m>\u001b[m\r\n\u001b[93m137 \u001b[m\u001b[8Csudo -u git env GITEA_WORK_DIR={{ gitea_home }} {{ gitea_path }} --config /etc/gitea/app.ini actions generate-runner-token\r\n\u001b[93m138 \u001b[m      \u001b[1m\u001b[96mregister\u001b[m\u001b[38;5;224m:\u001b[m runner_token_output\r\n\u001b[93m139 \u001b[m      \u001b[1m\u001b[96mchanged_when\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95mfalse\u001b[m\u001b[53;167H\u001b[K\u001b[53;167H139,1\u001b[9C73%\u001b[52;5H\u001b[?25h"]
[125347.476591, "o", "\u001b[?25l\u001b[1;52r\u001b[1;1H\u001b[6M\u001b[1;53r\u001b[47;1H\u001b[93m140 \u001b[m      \u001b[1m\u001b[96mwhen\u001b[m\u001b[38;5;224m:\u001b[m not runner_reg.stat.exists\r\n\u001b[93m141 \r\n142 \u001b[m    \u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Register Gitea Runner to run on the host OS\r\n\u001b[93m143 \u001b[m      \u001b[1m\u001b[96mcommand\u001b[m\u001b[38;5;224m:\u001b[m \u001b[38;5;224m>\u001b[m\r\n\u001b[93m144 \u001b[m\u001b[8Cgitea-runner register\r\n\u001b[93m145 \u001b[m\u001b[8C--no-interactive\u001b[53;167H\u001b[K\u001b[53;167H145,1\u001b[9C78%\u001b[52;5H\u001b[?25h"]
[125347.526528, "o", "\u001b[?25l\u001b[1;52r\u001b[1;1H\u001b[6M\u001b[1;53r\u001b[47;1H\u001b[93m146 \u001b[m\u001b[8C--instance http://127.0.0.1:300\r\n\u001b[93m147 \u001b[m\u001b[8C--token {{ runner_token_output.stdout }}\r\n\u001b[93m148 \u001b[m\u001b[8C--labels \"ubuntu-latest:host,debian-latest:host,local:host\"\r\n\u001b[93m149 \u001b[m      \u001b[1m\u001b[96margs\u001b[m\u001b[38;5;224m:\u001b[m\r\n\u001b[93m150 \u001b[m\u001b[8C\u001b[1m\u001b[96mchdir\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m\"{{ runner_home }}\"\u001b[m\r\n\u001b[93m151 \u001b[m      \u001b[1m\u001b[96mwhen\u001b[m\u001b[38;5;224m:\u001b[m not runner_reg.stat.exists\u001b[53;167H\u001b[K\u001b[53;167H151,1\u001b[9C83%\u001b[52;5H\u001b[?25h"]
[125347.559952, "o", "\u001b[?25l\u001b[1;52r\u001b[1;1H\u001b[6M\u001b[1;53r\u001b[47;1H\u001b[93m152 \r\n153 \u001b[m    \u001b[93m-\u001b[m \u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m Set permissions to read-only after installation.\r\n\u001b[93m154 \u001b[m      \u001b[1m\u001b[96mfile\u001b[m\u001b[38;5;224m:\u001b[m\r\n\u001b[93m155 \u001b[m\u001b[8C\u001b[1m\u001b[96mpath\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m\"{{ item.path }}\"\u001b[m\r\n\u001b[93m156 \u001b[m\u001b[8C\u001b[1m\u001b[96mowner\u001b[m\u001b[38;5;224m:\u001b[m root\r\n\u001b[93m157 \u001b[m\u001b[8C\u001b[1m\u001b[96mgroup\u001b[m\u001b[38;5;224m:\u001b[m git\u001b[53;167H\u001b[K\u001b[53;167H157,1\u001b[9C88%\u001b[52;5H\u001b[?25h"]
