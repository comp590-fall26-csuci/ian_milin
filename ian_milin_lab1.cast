[0.003, "o", "\u001b[1;1H\u001b[38;5;130mdef\u001b[m \u001b[36miterate\u001b[m(out, count=\u001b[31m0\u001b[m, prev=\u001b[31m1\u001b[m, val=\u001b[31m0\u001b[m):\r\n    \u001b[38;5;130mwhile\u001b[m count < \u001b[31m25\u001b[m:\u001b[2;22H\u001b[K\u001b[3;1H        \u001b[36mprint\u001b[m(\u001b[36mstr\u001b[m(val), file=out)\u001b[3;34H\u001b[K\u001b[4;9Hcount, prev, val = count + \u001b[31m1\u001b[m, val, val + prev\r\n\r\n\u001b[38;5;130mdef\u001b[m \u001b[36mfibonacci\u001b[m():\r\n    \u001b[38;5;130mwith\u001b[m \u001b[36mopen\u001b[m(\u001b[31m'output/out.txt'\u001b[m, \u001b[31m'w'\u001b[m) \u001b[38;5;130mas\u001b[m output:\u001b[8;9Hiterate(output)\r\n\r\nfibonacci\u001b[106m()\u001b[m\r\n\u001b[94m~                                                                                                                                                                                                       \u001b[12;1H~                                                                                                                                                                                                       \u001b[13;1H~                                                                                                                                                                                                       \u001b[14;1H~                                                                                                                                                                                                       \u001b[15;1H~                                                                                                                                                                                                       \u001b[16;1H~                                                                                                                                                                                                       \u001b[17;1H~       